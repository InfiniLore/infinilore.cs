@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using AterraEngine.Unions
@using InfiniLore.Modules.LsMarkdownFiles.Shared.Database
@using InfiniLore.Modules.LsMarkdownFiles.Shared.Services
@using InfiniLore.Shared
@using System.Text
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/{UserId:guid}/lorescope/{LoreScopeId:guid}/markdown"
@inject IInteractiveApiLsMarkdownFiles InteractiveApi
@inject NavigationManager NavigationManager
@attribute [Authorize]
@rendermode RenderModes.WebAssemblyOnly
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniSection>
    <h2 class="text-lg font-semibold text-(--color-base-90) mb-4">
        LoreScope Markdown Files
    </h2>

    <div class="flex items-center space-x-3">
        <InputText @bind-Value="@NewMarkdownFileName"
                   placeholder="Enter a new markdown file name..."
                   class="w-full bg-(--color-base-05) rounded-md border border-(--color-base-10) focus:ring-2 outline-none hover:ring-2 ring-(--color-accent) text-sm p-2 shadow-sm transition"/>

        <InfiniButton IconName="check" OnClick="CreateNewMarkdownFileAsync"
                      Disabled="NewMarkdownFileName.IsNullOrWhiteSpace()"/>
    </div>

    <hr class="my-4"/>

    @if (Files is null) {
        <span>Loading...</span>
    } else {
        <div class="flex flex-col gap-2">
            @* Table *@
            <InfiniTable TItem="ILsMarkdownFileModel" Items="@Files">
                <Header>
                    <InfiniTableHeader>File Name</InfiniTableHeader>
                    <InfiniTableHeader Alignment="right">Actions</InfiniTableHeader>
                </Header>
                <Content Context="file">
                    <InfiniTableCell>@file.Name</InfiniTableCell>
                    <InfiniTableCell Alignment="right">
                        <div class="flex justify-end gap-2">
                            <InfiniButton OnClick="() => GotoEditMarkdownFile(file)">Edit</InfiniButton>
                            <InfiniButton OnClick="async () => await DeleteMarkdownFileAsync(file)">Delete
                            </InfiniButton>
                        </div>
                    </InfiniTableCell>
                </Content>
            </InfiniTable>

            @* Navigation *@
            <div class="mt-4 flex justify-center items-center">
                <div class="flex gap-2">
                    @if (TotalPages > 1) {
                        <InfiniButton
                            OnClick="() => NavigationButton(CurrentPage - 1)"
                            Disabled="@(CurrentPage <= 0)">
                            Previous
                        </InfiniButton>
                    }
                    
                    <div class="text-(--color-base-70) flex flex-col justify-center items-center">
                        <span class="text-sm">Page @(CurrentPage + 1) of @TotalPages</span>
                        <span class="text-xs">@TotalCount total items</span>
                    </div>
                    
                    @if (TotalPages > 1) {
                        <InfiniButton
                            OnClick="() => NavigationButton(CurrentPage + 1)"
                            Disabled="@(CurrentPage >= TotalPages - 1)">
                            Next
                        </InfiniButton>
                    }
                </div>
            </div>

        </div>
    }

</InfiniSection>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public Guid UserId { get; set; }
    [Parameter] public Guid LoreScopeId { get; set; }

    private ILsMarkdownFileModel[]? Files { get; set; }
    private int TotalCount { get; set; }
    private int CurrentPage { get; set; }
    private int TotalPages { get; set; }


    private string? NewMarkdownFileName { get; set; }

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        await FetchFilesAsync(1);
    }

    private async Task FetchFilesAsync(int pageNumber) {
        if (Files is not null) Files = null;
        var pagination = new PaginationInfo {
            PageNumber = pageNumber,// Already 1-based, don't adjust
            PageSize = 10
        };

        PaginatedResult<ILsMarkdownFileModel> result = await InteractiveApi.GetLsMarkdownFilesAsync(LoreScopeId.ToString(), pagination);
        if (!result.TryGetAsData(out PaginatedData<ILsMarkdownFileModel>? data)) return;

        PaginatedData<ILsMarkdownFileModel> paginated = data.Value;
        Files = paginated.Items;
        TotalCount = paginated.TotalCount;
        CurrentPage = paginated.CurrentPage - 1;// Convert to 0-based for UI
        TotalPages = paginated.TotalPages;
    }


    private void GotoEditMarkdownFile(ILsMarkdownFileModel file) {
        NavigationManager.NavigateTo($"/{UserId}/lorescope/{LoreScopeId}/markdown/{file.Id}/editor");
    }

    private async Task DeleteMarkdownFileAsync(ILsMarkdownFileModel file) {
        Result result = await InteractiveApi.DeleteLsMarkdownFileAsync(file.OwnerId.ToString(), file.Id.ToString());
        if (!result.TryGetAsState(out bool? deleted) || deleted is false) return;

        await FetchFilesAsync(0);
        StateHasChanged();
    }

    private async Task CreateNewMarkdownFileAsync() {
        if (NewMarkdownFileName.IsNullOrEmpty()) return;

        byte[] textBytes = Encoding.UTF8.GetBytes($"# File: {NewMarkdownFileName}");
        using var stream = new MemoryStream(textBytes);

        string? fileName = NewMarkdownFileName.EndsWith(".md")
            ? NewMarkdownFileName
            : $"{NewMarkdownFileName}.md";

        Result _ = await InteractiveApi.UpsertLsMarkdownFileAsync(
            LoreScopeId.ToString(),
            fileName,
            stream
        );

        await FetchFilesAsync(0);
        StateHasChanged();
    }

    private async Task NavigationButton(int page) {
        // Convert from 0-based UI page to 1-based server page
        await FetchFilesAsync(page + 1);
        StateHasChanged();
    }
}