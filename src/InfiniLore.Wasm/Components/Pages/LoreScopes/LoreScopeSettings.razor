@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using Infinilore.InfiniBlazor
@using InfiniLore.Modules.Core.Shared
@using InfiniLore.Modules.LoreScopes.Shared.Database
@using InfiniLore.Modules.LoreScopes.Shared.Services
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/{UserId:guid}/lorescope/{LoreScopeId:guid}/settings"
@inject IInteractiveApiLoreScopes LoreScopeInteractiveApi
@inject ILogger<LoreScopeSettings> Logger
@inject NavigationManager NavigationManager
@attribute [Authorize]
@rendermode InteractiveAuto
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniPage>
    <InfiniSection>
        <InfiniHeading3>
            LoreScope Settings
        </InfiniHeading3>
    </InfiniSection>
    
    <InfiniSection>
        <InfiniHeading5>
            LoreScope Details
        </InfiniHeading5>
        
        <InfiniTextInput
            Label="Name"
            Placeholder="Enter a name"
            ValidationMessage="@LoreScopeNameValidationMessage"
            @bind-Value="@LoreScopeName">
            <InfiniButton OnClick="OnNameSubmitAsync">Submit</InfiniButton>
        </InfiniTextInput>
        
        <InfiniSpacerVertical Spacing="Size.M"/>
        
        <InfiniHeading5>
            LoreScope Image
        </InfiniHeading5>
        
        <LoreScopePoster ImageUrl="@LoreScopeModel?.S3PosterImageUrl" Name="@LoreScopeModel?.Name"/>
        
        <div class="mt-4">
            <div class="flex flex-row justify-between">
                <div class="relative">
                    <InputFile OnChange="@OnPosterImageSelected"
                               class="w-full text-sm text-(--color-base-30) transition-all duration-150 transform cursor-pointer
                         file:cursor-pointer active:file:scale-95 file:mr-4 file:px-2 file:py-1 
                         file:text-base file:rounded-md file:bg-(--color-base-70) file:text-(--color-base-00) 
                         hover:file:text-(--color-accent) hover:file:ring-2 hover:ring-(--color-accent) 
                         hover:file:scale-105 p-1"
                               accept="image/*" />
                </div>

                <InfiniButton OnClick="OnPosterImageUpload" Disabled="@(SelectedFile is null)" IconName="check"/>
            </div>
        </div>
        
        <InfiniSpacerVertical Spacing="Size.M"/>

        <InfiniHeading5>
            Danger zone
        </InfiniHeading5>
        
        <InfiniButton 
            IconName="trash"
            OnClick="@OnDeleteAsync"
            >
            Delete LoreScope
        </InfiniButton>
        
    </InfiniSection>

</InfiniPage>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    [Parameter] public Guid LoreScopeId { get; set; }
    [Parameter] public Guid UserId { get; set; }

    
    private ILoreScopeModel? _loreScopeModel;
    private ILoreScopeModel? LoreScopeModel {
        get => _loreScopeModel;
        set {
            _loreScopeModel = value;
            LoreScopeName = _loreScopeModel?.Name;
        }
    }

    private IBrowserFile? SelectedFile { get; set; }
    private const int MaxFileSize = 5 * 1024 * 1024; // 5MB in bytes

    private string? LoreScopeName { get; set; }
    private string? LoreScopeNameValidationMessage { get; set; }

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        Outcome<ILoreScopeModel> outcome = await LoreScopeInteractiveApi.GetLoreScopeAsync(
            UserId.ToString(),
            LoreScopeId.ToString()
        );
        
        if (!outcome.TryGetAsData(out ILoreScopeModel? model)) {
            Logger.Warning("Could not retrieve model");

            LoreScopeModel = null;
            return;
        }

        LoreScopeModel = model;
    }

    private void OnPosterImageSelected(InputFileChangeEventArgs e) {
        if (e.File is not {} file) return;
        SelectedFile = file;
        StateHasChanged();
    }

    private async Task OnNameSubmitAsync() {
        if (LoreScopeName.IsNullOrWhiteSpace()) {
            LoreScopeNameValidationMessage = "Name cannot be empty";
            return;
        }

        Outcome outcome = await LoreScopeInteractiveApi.UpdateLoreScopeNameAsync(UserId.ToString(), LoreScopeId.ToString(), LoreScopeName);
        outcome.Switch(
            () => LoreScopeNameValidationMessage = null,
            () => LoreScopeNameValidationMessage = "Could not update LoreScope Name",
            error => LoreScopeNameValidationMessage = error
        );
        StateHasChanged();
    }
    
    private async Task OnPosterImageUpload() {
        if (SelectedFile is null) return;

        try {
            // 5MB limit
            if (SelectedFile.Size > MaxFileSize) {
                Logger.Warning("File size exceeds 5MB limit");
                return;
            }
            
            Outcome outcome = await LoreScopeInteractiveApi.UpsertLoreScopeImageAsync(
                UserId.ToString(),
                LoreScopeId.ToString(),
                SelectedFile
            );

            if (!outcome.TryGetAsState(out bool success) || !success ) {
                Logger.Error("Failed to upload image, {@e}", outcome);
                return;
            }

            // Refresh the LoreScope model to get the updated image URL
            await OnInitializedAsync();
            SelectedFile = null;
        }
        finally {
            StateHasChanged();
        }
    }
    
    private async Task OnDeleteAsync() {
        Outcome outcome = await LoreScopeInteractiveApi.DeleteLoreScopesAsync(UserId.ToString(), LoreScopeId.ToString());
        if (!outcome.IsTrue) return;
        NavigationManager.NavigateTo("/lorescopes");
    }
}