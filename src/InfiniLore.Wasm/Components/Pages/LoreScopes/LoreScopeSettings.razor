@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using AterraEngine.Unions
@using InfiniLore.Shared.Modules.LoreScopes.Database
@using InfiniLore.Shared.Modules.LoreScopes.Services
@using System.Diagnostics.CodeAnalysis
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/{UserId:guid}/lorescope/{LoreScopeId:guid}/settings"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ILoreScopeInteractiveApi LoreScopeInteractiveApi
@inject ILogger<LoreScopeSettings> Logger
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniSection>
    <h2 class="text-lg font-semibold text-(--color-base-90) mb-4">
        LoreScope Settings
        <span class="text-sm text-(--color-base-50)">
            Id: @LoreScopeId
        </span>
    </h2>
</InfiniSection>

<div class="my-8"></div>

@if (LoreScopeModelFound) {
    <InfiniSection>
        <h2 class="text-lg font-semibold text-(--color-base-90) mb-4">
            LoreScope Image
        </h2>
        <LoreScopePoster ImageUrl="@LoreScopeModel.S3PosterImageUrl" Name="@LoreScopeModel.Name"/>

        <div class="mt-4">
            <div class="flex flex-row justify-between">
                <div class="relative">
                    <InputFile OnChange="@OnPosterImageSelected" 
                               class="w-full text-sm text-gray-700 transition-all duration-150 transform cursor-pointer
                     file:cursor-pointer active:file:scale-95 file:mr-4 file:px-2 file:py-1 
                     file:text-base file:rounded-md file:bg-(--color-base-70) file:text-(--color-base-00) 
                     hover:file:text-(--color-accent) hover:file:ring-2 hover:ring-(--color-accent) 
                     hover:file:scale-105 p-1"
                               accept="image/*" />
                </div>

                <InfiniButton OnClick="OnPosterImageUpload" Disabled="@(SelectedFile is null)" IconName="check"/>
            </div>
            @if (IsUploading) {
                <div class="mt-2 text-sm text-(--color-primary-500)">Uploading...</div>
            }
        </div>

    </InfiniSection>
}

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public Guid LoreScopeId { get; set; }
    [Parameter] public Guid UserId { get; set; }

    private ILoreScopeModel? LoreScopeModel { get; set; }
    [MemberNotNullWhen(true, nameof(LoreScopeModel))] private bool LoreScopeModelFound { get; set; }

    private bool IsUploading { get; set; }
    private IBrowserFile? SelectedFile { get; set; }
    private const int MaxFileSize = 5 * 1024 * 1024; // 5MB in bytes

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        Result<ILoreScopeModel> result = await LoreScopeInteractiveApi.GetLoreScopeAsync(
            UserId.ToString(),
            LoreScopeId.ToString()
        );
        
        if (!result.TryGetAsSuccess(out ILoreScopeModel model)) {
            Logger.Warning("Could not retrieve model");

            LoreScopeModel = null;
            LoreScopeModelFound = false;
            return;
        }

        LoreScopeModel = model;
        LoreScopeModelFound = true;
    }

    private void OnPosterImageSelected(InputFileChangeEventArgs e) {
        if (e.File is not {} file) return;
        SelectedFile = file;
        IsUploading = true; 
        StateHasChanged();
    }
    private async Task OnPosterImageUpload() {
        if (SelectedFile is null) return;

        try {
            // 5MB limit
            if (SelectedFile.Size > MaxFileSize) {
                Logger.LogWarning("File size exceeds 5MB limit");
                return;
            }

            await using Stream stream = SelectedFile.OpenReadStream(MaxFileSize);
            Result result = await LoreScopeInteractiveApi.UpsertLoreScopeImageAsync(
                UserId.ToString(),
                LoreScopeId.ToString(),
                SelectedFile.Name,
                SelectedFile.ContentType,
                stream
            );

            if (!result.TryGetAsState(out bool success)) {
                Logger.LogError("Failed to upload image");
                return;
            }

            // Refresh the LoreScope model to get the updated image URL
            await OnInitializedAsync();
            SelectedFile = null;
        }
        finally {
            IsUploading = false;
            StateHasChanged();
        }
    }


}