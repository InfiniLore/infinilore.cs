@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using AterraEngine.Unions
@using InfiniLore.Modules.LsMarkdownFiles.Shared.Database
@using InfiniLore.Modules.LsMarkdownFiles.Shared.Services
@using System.Text
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/{UserId:guid}/lorescope/{LoreScopeId:guid}/markdown/{MarkdownId:guid}/editor"
@inject ILsMarkdownFileInteractiveApi InteractiveApi
@inject HttpClient Http
@inject ILogger<LoreScopeMarkdownEditor> Logger
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniSection>
    <h2 class="text-lg font-semibold text-(--color-base-90) mb-4">
        LoreScope Markdown File Editor
    </h2>

    @if (FileModel is null) {
        <span>Loading...</span>
    } else {
        @* File changes *@
        <div class="flex flex-col">
            <div class="flex flex-row items-center space-x-3">
                <InputText @bind-Value="@FileModel.Name"
                           placeholder="Enter a file name..."
                           class="w-full bg-(--color-base-05) rounded-md border border-(--color-base-10) focus:ring-2 outline-none hover:ring-2 ring-(--color-accent) text-sm p-2 shadow-sm transition"/>

                <InfiniButton IconName="check" OnClick="SetFileNameAsync" Disabled="FileModel.Name.IsNullOrWhiteSpace()"/>
            </div>
            <div class="flex flex-row-reverse items-center space-x-3">
                <InfiniButton IconName="save" OnClick="SaveFileAsync" Disabled="@(FileModel is null)">Save File</InfiniButton>
            </div>
        </div>

        @* Editor *@
        <MarkdownEditor Source="@TextSource"/>
    }

</InfiniSection>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    [Parameter] private Guid UserId { get; set; }
    [Parameter] private Guid LoreScopeId { get; set; }
    [Parameter] private Guid MarkdownId { get; set; }

    private TextSource TextSource { get; } = new();
    private ILsMarkdownFileModel? FileModel { get; set; }

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        Result<ILsMarkdownFileModel> result = await InteractiveApi.GetLsMarkdownFileAsync(LoreScopeId.ToString(), MarkdownId.ToString());
        if (!result.TryGetAsSuccess(out ILsMarkdownFileModel? model)) return;

        FileModel = model;

        if (model.ResourceUrl is null) return;

        try {
            string content = await Http.GetStringAsync(model.ResourceUrl);
            TextSource.Text = content;
        }
        catch (Exception ex) {
            Logger.Warning(ex, "Failed to download markdown content");
        }

    }

    private async Task SetFileNameAsync() => await SaveFileAsync();

    private async Task SaveFileAsync() {
        if (FileModel is null) return;
        if (FileModel.Name.IsNullOrWhiteSpace()) return;

        byte[] textBytes = Encoding.UTF8.GetBytes(TextSource.Text);
        using var stream = new MemoryStream(textBytes);

        Result _ = await InteractiveApi.UpsertLsMarkdownFileAsync(
            FileModel.OwnerId.ToString(),
            FileModel.Name,
            stream
        );
    }
}