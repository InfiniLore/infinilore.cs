@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/api-test"
@using AterraEngine.Unions
@using InfiniLore.Shared
@using InfiniLore.Shared.Auth
@using InfiniLore.Shared.Modules.LoreScopes.Database
@using InfiniLore.Shared.Modules.LoreScopes.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Text.Json
@attribute [Authorize]
@rendermode InteractiveServer
@inject ILogger<ApiTest> Logger
@inject ILoreScopeInteractiveApi LoreScopeInteractiveApi
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>API TEST</PageTitle>
<div>
    @RendererInfo.Name
</div>
<div>
    <br>
    <button class="btn btn-primary" @onclick="CallInternalApi">Call internal API</button>
    <pre>@_apiResponse</pre>
</div>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }
    private string _apiResponse = "";

    private async Task CallInternalApi() {
        if (AuthenticationState is null) {
            _apiResponse = "NOT AUTHENTICATED";
            return;
        }

        AuthenticationState state = await AuthenticationState;
        string? userId = state.User.FindFirstValue(InfiniLoreClaimsStoreConstants.UserId);

        if (userId.IsNullOrWhiteSpace()) {
            Logger.Information("user: {@user}", state.User);
            _apiResponse = "User Id Not Found";
            return;
        }

        PaginatedDataResult<ILoreScopeModel> result = await LoreScopeInteractiveApi.GetLoreScopesAsync(userId);
        if (result.TryGetAsErrorValue(out string? value)) {
            _apiResponse = value;
        }

        string dataAsJson = JsonSerializer.Serialize(result.AsData);
        _apiResponse = dataAsJson;
    }
}