@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using InfiniLore.Kiota
@using InfiniLore.Kiota.Api.V1.DataUser.Item.Lorescope
@using InfiniLore.Kiota.Extensions
@using InfiniLore.Modules.Core.Wasm.Contracts.Services
@using InfiniLore.Modules.LoreScopes.Shared.Database
@using InfiniLore.Modules.LoreScopes.Shared.Services
@using InfiniLore.Shared
@using InfiniLore.Shared.Auth
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Kiota.Abstractions
@using System.Security.Claims
@using System.Text.Json
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/api-test"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@inject ILogger<ApiTest> Logger
@inject IInteractiveApiLoreScopes LoreScopeInteractiveApi
@inject IServiceProvider Provider
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniPage>
    <InfiniSection class="h-screen flex flex-col gap-4">
        <InfiniHeading3>API Test</InfiniHeading3>

        <div class="flex flex-col gap-4">
            <span> Render Mode: <span class="font-bold">@RendererInfo.Name</span> </span>
            <div class="flex flex-col h-48">
                Request Data:
                
                @if (RendererInfo.IsInteractive) {
                    <InfiniCodeBlock Content="@GetUrl()" EnableCopy="false"></InfiniCodeBlock>
                }
            </div>

            <InfiniButton OnClick="CallInternalApi" Disabled="@(!RendererInfo.IsInteractive)">
                Call Internal API
            </InfiniButton>
        </div>

        <div class="grow flex overflow-y-auto overflow-x-clip">
            <InfiniCodeBlock Content="@_apiResponse" Class="w-full" Language="json"/>
        </div>
    </InfiniSection>
</InfiniPage>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }
    private string _apiResponse = "Nothing called yet";
    private string? _userId = string.Empty;

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        if (AuthenticationState is null) {
            Logger.Warning("user is not authenticated");
            return;
        }

        AuthenticationState state = await AuthenticationState;
        _userId = state.User.FindFirstValue(InfiniLoreClaimsStoreConstants.UserId);
    }

    private async Task CallInternalApi() {
        if (_userId.IsNullOrWhiteSpace()) {
            Logger.Information("user: {@user}", _userId);
            _apiResponse = "User Id Not Found";
            return;
        }

        PaginatedResult<ILoreScopeModel> result = await LoreScopeInteractiveApi.GetLoreScopesAsync(_userId, Pagination.Default);
        if (result.TryGetAsErrorValue(out string? value)) {
            _apiResponse = value;
            StateHasChanged();
            return;
        }

        string dataAsJson = JsonSerializer.Serialize(result.AsData, new JsonSerializerOptions {
            WriteIndented = true,
        });
        _apiResponse = dataAsJson;
        StateHasChanged();
    }

    private string GetUrl() {
        if (Provider.GetService<IInteractiveApiWasm>() is not {} interactiveApiWasm) return string.Empty;
        InfiniLoreApiClient client = interactiveApiWasm.ApiClient;
        LorescopeRequestBuilder? requestBuilder = client.Api.V1.DataUser[_userId].Lorescope;
        RequestInformation info =  requestBuilder.ToGetRequestInformation();
            
        string method = info.HttpMethod.ToHttpMethodString();
        string url = info.URI.AbsoluteUri;
        return $"{method} {url}";
    }
}