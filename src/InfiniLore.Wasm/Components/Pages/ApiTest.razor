@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using InfiniLore.Shared
@using InfiniLore.Shared.Auth
@using InfiniLore.Shared.Modules.LoreScopes.Database
@using InfiniLore.Shared.Modules.LoreScopes.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Text.Json
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/api-test"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@inject ILogger<ApiTest> Logger
@inject ILoreScopeInteractiveApi LoreScopeInteractiveApi
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniSection>
    <h2 class="text-lg font-semibold text-(--color-base-90) mb-4">
        API Test
    </h2>

    <div class="flex flex-col gap-4">
        <span> Render Mode: <span class="font-bold">@RendererInfo.Name</span> </span>
        
        <InfiniButton OnClick="CallInternalApi" Disabled="@(!RendererInfo.IsInteractive)">
            Call Internal API
        </InfiniButton>
        
        <pre class="bg-gray-50 text-sm border border-gray-200 rounded p-4 overflow-auto w-full break-words">@_apiResponse</pre>
    </div>
</InfiniSection>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }
    private string _apiResponse = "Nothing called yet";

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    private async Task CallInternalApi() {
        if (AuthenticationState is null) {
            _apiResponse = "NOT AUTHENTICATED";
            return;
        }

        AuthenticationState state = await AuthenticationState;
        string? userId = state.User.FindFirstValue(InfiniLoreClaimsStoreConstants.UserId);

        if (userId.IsNullOrWhiteSpace()) {
            Logger.Information("user: {@user}", state.User);
            _apiResponse = "User Id Not Found";
            return;
        }

        PaginatedResult<ILoreScopeModel> result = await LoreScopeInteractiveApi.GetLoreScopesAsync(userId);
        if (result.TryGetAsErrorValue(out string? value)) {
            _apiResponse = value;
        }

        string dataAsJson = JsonSerializer.Serialize(result.AsData, new JsonSerializerOptions {
            WriteIndented = true,
        });
        _apiResponse = dataAsJson;
        StateHasChanged();
    }
}