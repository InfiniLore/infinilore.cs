@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using AterraEngine.Unions
@using InfiniLore.InfiniBlazor.Toasting
@using InfiniLore.Shared.Modules.MarkdownFiles.Database
@using InfiniLore.Shared.Modules.MarkdownFiles.Services
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/markdown-file/{LoreScopeId:guid}/{MarkdownFileId:guid}/editor"
@inject IMarkdownFileInteractiveApi MarkdownFileApi
@inject IToastStorage ToastStorage
@rendermode InteractiveWebAssembly
@attribute [Authorize]
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<div>
    @* BUTTON TO SAVE CONTENT *@
    <button class="btn btn-primary" @onclick="SaveAsync">Save</button>
    <input @bind="FileName"/>
</div>
@if (IsEnabled) {
    <MarkdownEditor Source="@TextSource"></MarkdownEditor>
}
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    private string FileName { get; set; } = string.Empty;
    private ITextSource TextSource { get; set; } = new TextSource();
    [Parameter] public Guid MarkdownFileId { get; set; }
    [Parameter] public Guid LoreScopeId { get; set; }

    private bool IsEnabled { get; set; } = true;
    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        if (MarkdownFileId == Guid.Empty) return;
        Result<IMarkdownFileModel> markdownFileResult = await MarkdownFileApi.GetMarkdownFileAsync(LoreScopeId.ToString(), MarkdownFileId.ToString());
        if (!markdownFileResult.TryGetAsSuccess(out IMarkdownFileModel response)) {
            IsEnabled = false;
            var toast = new ToastData("Error: Retrieval failed", -1, ToastAppearance.Default, Body: "Could not retrieve markdown file from api");
            await ToastStorage.AddToastAsync(toast);
            return;
        }

        FileName = response.Name;
        TextSource.Text = response.Source;
    }
    private async Task SaveAsync() {
        if (MarkdownFileId == Guid.Empty) MarkdownFileId = Guid.NewGuid();
        Result result = await MarkdownFileApi.UpsertMarkdownFileAsync(LoreScopeId.ToString(), MarkdownFileId.ToString(), FileName, TextSource.Text);
        IsEnabled = result is { IsState: true, AsState: true };
    }
}