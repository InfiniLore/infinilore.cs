@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using AterraEngine.Unions
@using InfiniLore.Shared
@using InfiniLore.Shared.Modules.LoreScopes.Database
@using InfiniLore.Shared.Modules.LoreScopes.Services
@using InfiniLore.Shared.Modules.MarkdownFiles.Database
@using InfiniLore.Shared.Modules.MarkdownFiles.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/markdown-test"
@inject ILoreScopeInteractiveApi LoreScopeApi
@inject IMarkdownFileInteractiveApi MarkdownFileApi
@inject ILogger<MarkdownTest> Logger
@attribute [Authorize]
@rendermode InteractiveServer
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
@foreach (ILoreScopeModel loreScope in LoreScopeResponses) {
    <h3>@loreScope.Name</h3>
    <ul>
        @foreach ((Guid, string)tuple in MarkdownFileMap[loreScope.Id]) {
            <li>@tuple.Item2 <a href="markdown-file/@loreScope.Id/@tuple.Item1">Editor</a></li>
        }
        <li><a href="markdown-file/@loreScope.Id/@Guid.Empty">New</a></li>
    </ul>
}
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }
    private ILoreScopeModel[] LoreScopeResponses { get; set; } = [];
    private Dictionary<Guid, (Guid, string)[]> MarkdownFileMap { get; set; } = new();
    
    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        if (AuthenticationState is null) return;
        AuthenticationState state = await AuthenticationState;
        string? userId = state.User.FindFirstValue(InfiniLoreClaimsStoreConstants.UserId);
        if (userId.IsNullOrWhiteSpace()) return;
        
        Result<PaginatedData<ILoreScopeModel>> result = await LoreScopeApi.GetLoreScopesAsync(userId);
        if (!result.TryGetAsSuccess(out PaginatedData<ILoreScopeModel> response)) {
            return;
        }
        
        MarkdownFileMap = response.Items.ToDictionary(r => r.Id, _ => Array.Empty<(Guid, string)>());
        LoreScopeResponses = response.Items;
        
        foreach (ILoreScopeModel scope in LoreScopeResponses) {
            (Guid, string)[] files = await GetMarkdownFilesAsync(scope.Id);
            MarkdownFileMap[scope.Id] = files;
        }
    }

    private async Task<(Guid, string)[]> GetMarkdownFilesAsync(Guid loreScopeId) {
        Result<PaginatedData<IMarkdownFileModel>> result = await MarkdownFileApi.GetMarkdownFilesAsync(loreScopeId.ToString());
        if (!result.TryGetAsSuccess(out PaginatedData<IMarkdownFileModel> response)) return [];
        
        return response.Items.Select(r => (r.Id, r.Name)).ToArray();
    }
}