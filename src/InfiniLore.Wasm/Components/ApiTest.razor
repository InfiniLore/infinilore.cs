@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/api-test"
@using InfiniLore.Shared
@using InfiniLore.Shared.Services.InteractiveApi
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@inject ILogger<ApiTest> Logger
@inject IInteractiveApi InteractiveApiAccess
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>API TEST</PageTitle>
<div>
    @RendererInfo.Name
</div>
<div>
    <br>
    <button class="btn btn-primary" @onclick="CallInternalApi">Call internal API</button>
    <pre>@_apiResponse</pre>
</div>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }
    private string _apiResponse = "";

    private async Task CallInternalApi() {
        if (AuthenticationState is null) {
            _apiResponse = "NOT AUTHENTICATED";
            return;
        }

        AuthenticationState state = await AuthenticationState;
        string? userId = state.User.FindFirstValue(InfiniLoreClaimsStoreConstants.UserId);

        if (userId.IsNullOrWhiteSpace()) {
            Logger.Information("user: {@user}", state.User);
            _apiResponse = "User Id Not Found";
            return;
        }

        // Result<LoreScopesResponse> result = await InteractiveApiAccess.GetLoreScopesAsync(userId);
        // if (result.TryGetAsErrorValue(out string? value)) {
        //     _apiResponse = value;
        // }

        // string dataAsJson = JsonSerializer.Serialize(result.AsSuccess);
        // _apiResponse = dataAsJson;
    }
}