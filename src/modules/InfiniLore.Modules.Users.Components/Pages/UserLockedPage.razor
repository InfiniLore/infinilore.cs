@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using FastEndpoints
@using InfiniLore.Core.Outcomes
@using InfiniLore.Modules.Users.Database
@using InfiniLore.Modules.Users.Messaging.Queries
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@namespace InfiniLore.Core.Pages
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/UserLockedPage"
@rendermode InfiniRenderModeProvider.InfiniRenderMode
@attribute [Authorize]

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniPage Title="Locked">
    <InfiniSection>
        
        <p>Your account @_userName has been locked.</p>
        
    </InfiniSection>
</InfiniPage>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }
    
    private string _userName = string.Empty;
    
    protected override async Task OnInitializedAsync() {
        Outcome<UserModel> outcome = await new GetCurrentUserQuery().ExecuteAsync(CancellationToken.None);

        if (!outcome.TryGetAsSuccess(out UserModel? result)) {
            _userName = "Unknown";
            return;
        }
        
        _userName = result.UserName;
    }
}