@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using InfiniLore.Clients.Kiota
@using InfiniLore.Clients.Kiota.Models
@using InfiniLore.ServerClient.Shared
@using InfiniLore.ServerClient.Shared.JwtToken
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Kiota.Abstractions
@using Microsoft.Kiota.Serialization
@using System.Security.Claims
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/api-test"
@attribute [Authorize]
@rendermode RenderModes.WebAssemblyOnly
@inject InfiniLoreApiClient ApiClient
@inject IJsSecureStorageJwtTokenProvider TokenProvider
@inject ILogger<ApiTest> Logger
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>API TEST</PageTitle>
<div>
    <br>
    <button class="btn btn-primary" @onclick="CallInternalApi">Call internal API</button>
    <pre>@_apiResponse</pre>
</div>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }
    private string _apiResponse = "";

    private async Task CallInternalApi() {
        if (AuthenticationState is null) {
            _apiResponse = "NOT AUTHENTICATED";
            return;
        }

        AuthenticationState state = await AuthenticationState;
        string? userId = state.User.FindFirstValue(InfiniLoreClaimsStoreConstants.UserId);

        if (userId.IsNullOrWhiteSpace()) {
            Logger.Information("user: {@user}", state.User);
            
            _apiResponse = "User Id Not Found";
            return;
        }

        string? token = await TokenProvider.GetTokenAsync();
        if (token.IsNullOrWhiteSpace()) {
            _apiResponse = "TOKEN NOT FOUND";
            return;
        }

        try {
            InfiniLoreServerApiResponsesDataUserLoreScopesLoreScopesResponse? result = await ApiClient.Api.V1.Data.User[userId].Lorescope
                .GetAsync(configuration => configuration.AddJwtToken(token));
            if (result is null) {
                _apiResponse = "Could not get data from API";
                return;
            }
            
            string json = await result.SerializeAsJsonStringAsync();
            _apiResponse = $"This data comes from an internal API: {Environment.NewLine} {json}";
        }
        catch (Exception e) {
            _apiResponse = e.Message;
        }
    }
}