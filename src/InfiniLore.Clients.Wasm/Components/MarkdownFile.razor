@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using AterraEngine.Unions
@using InfiniLore.InfiniBlazor.Markdown
@using InfiniLore.Server.Api.Responses.Data.Project.MarkdownFiles
@using InfiniLore.ServerClient.Services

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/markdown-file/{LoreScopeId:guid}/{MarkdownFileId:guid}"
@inject IInteractiveApiAccess InteractiveApiAccess
@rendermode  InteractiveWebAssembly
@attribute [Authorize]
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<div>
    @* BUTTON TO SAVE CONTENT *@
    <button class="btn btn-primary" @onclick="SaveAsync">Save</button>
    <input @bind="FileName"/>
</div>
@if (IsEnabled) {
    <MarkdownEditor Source="@TextSource"></MarkdownEditor>
}
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    private string FileName { get; set; } = string.Empty;
    private ITextSource TextSource { get; set; } = new TextSource();
    [Parameter] public Guid MarkdownFileId { get; set; }
    [Parameter] public Guid LoreScopeId { get; set; }

    private bool IsEnabled { get; set; } = true;
    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        if (MarkdownFileId == Guid.Empty) return;
        Result<MarkdownFileResponse> markdownFileResult = await InteractiveApiAccess.GetMarkdownFileAsync(LoreScopeId.ToString(), MarkdownFileId.ToString());
        if (!markdownFileResult.TryGetAsSuccess(out MarkdownFileResponse response)) {
            IsEnabled = false;
            return;
        }

        FileName = response.Name;
        TextSource.Text = response.Source;
    }
    private async Task SaveAsync() {
        if (MarkdownFileId == Guid.Empty) MarkdownFileId = Guid.NewGuid();
        Result result = await InteractiveApiAccess.UpsertMarkdownFileAsync(LoreScopeId.ToString(), MarkdownFileId.ToString(), FileName, TextSource.Text);
        IsEnabled = result is { IsState: true, AsState: true };
    }
}