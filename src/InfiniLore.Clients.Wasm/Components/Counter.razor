@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using InfiniLore.ServerClient.Shared.JwtToken
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Headers
@using System.Security.Claims
@using System.Text.Json
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/counter"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@inject IHttpClientFactory ClientFactory
@inject IJsSecureStorageJwtTokenProvider TokenProvider
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>API TEST</PageTitle>
<div>
    <br>
    <button class="btn btn-primary" @onclick="CallInternalApi">Call internal API</button>
    <pre>@_apiResponse</pre>
</div>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string _apiResponse = "";
    
    private static readonly JsonSerializerOptions Options = new() { WriteIndented = true };

    private async Task CallInternalApi() {
        if (AuthenticationState is null) {
            _apiResponse = "NOT AUTHENTICATED";
            return;
        }
        
        AuthenticationState state = await AuthenticationState;
        string? userId = state.User.FindFirstValue("infinilore_user_id");
        
        if (userId.IsNullOrWhiteSpace()) {
            _apiResponse = "User Id Not Found";
            return;
        }
        
        string? token = await TokenProvider.GetTokenAsync();
        if (token.IsNullOrWhiteSpace()) {
            _apiResponse = "TOKEN NOT FOUND";
            return;
        }

        try {
            using HttpClient client = ClientFactory.CreateClient("ServerAPI");
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/v1/data/user/{userId}/lorescope");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            
            HttpResponseMessage result = await client.SendAsync(request);
            string json = JsonSerializer.Serialize(JsonDocument.Parse(await result.Content.ReadAsStringAsync()).RootElement, Options);
        
            _apiResponse = $"This data comes from an internal API: {Environment.NewLine} {json}";
        }
        catch (Exception e) {
            _apiResponse = e.Message;
        }
    }
}