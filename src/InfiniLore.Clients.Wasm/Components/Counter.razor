@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/counter"
@using InfiniLore.ServerClient.Shared.JwtToken
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Headers
@attribute [Authorize]
@rendermode RenderModes.WebAssemblyOnly
@inject IHttpClientFactory ClientFactory
@inject IJsSecureStorageJwtTokenProvider TokenProvider
@inject ILogger<Counter> Logger

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p>Hello @(_isLoading ? "Loading..." : Username)!</p>

<p role="status">Current count: @_currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

<div>
    <br>
    <button class="btn btn-primary" @onclick="CallInternalApi">Call internal API</button>
    <p>@_apiResponse</p>
</div>


@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    private int _currentCount;
    
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string _apiResponse = "";//👈 new code

    private bool _isLoading = true; // Flag to track loading state
    private string? Username { get; set; } = "some name";

    protected override async Task OnInitializedAsync() {
        if (AuthenticationState != null) {
            AuthenticationState state = await AuthenticationState;
            Username = state.User.Identity?.Name;
            _currentCount += 1;
        }
        _isLoading = false; // Set flag to false after loading is complete
    }
    
    private void IncrementCount() {
        _currentCount++;
    }

    private async Task CallInternalApi() {
        // const string userId = "0195a3f1-7826-7cfe-9346-b787375377c8";
        const string userId = "0195a53f-ff2f-7f2f-9fbe-bd9b986b956d";
        
        string? token = await TokenProvider.GetTokenAsync();
        if (token.IsNullOrWhiteSpace()) {
            _apiResponse = "TOKEN NOT FOUND";
            return;
        }
        Logger.Warning($"{token}", token);

        try {
            using HttpClient client = ClientFactory.CreateClient("ServerAPI");
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/v1/data/user/{userId}/lorescope");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            
            
            HttpResponseMessage result = await client.SendAsync(request);
        
            _apiResponse = $"This data comes from an internal API: {string.Join(",", await result.Content.ReadAsStringAsync())}";
        }
        catch (Exception e) {
            _apiResponse = e.Message;
        }
    }
}