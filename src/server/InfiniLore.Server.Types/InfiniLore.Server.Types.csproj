<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>

        <!-- Main package name -->
        <PackageId>InfiniLore.Server.Types</PackageId>
        <Version>0.0.4</Version>
        <Authors>Anna Sas</Authors>
        <Description>A small library of commonly used types within the InfiniLore Server</Description>
        <PackageProjectUrl>https://github.com/InfiniLore/infinilore.cs</PackageProjectUrl>
        <PackageTags>infinilore</PackageTags>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <DebugType>embedded</DebugType>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="AterraEngine.Unions" Version="2.5.0" />
        <PackageReference Include="AterraEngine.Unions.Generators" Version="2.5.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
    </ItemGroup>

    <ItemGroup Label="InternalsVisibleTo">
        <InternalsVisibleTo Include="Tests.InfiniLore.Server.Types" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../../LICENSE" Pack="true" PackagePath="" Visible="false" />
        <None Include="../../../README.md" Pack="true" PackagePath="" Visible="false" />
        <None Include="../../../assets/icon.png" Pack="true" PackagePath="" Visible="false" />
    </ItemGroup>

</Project>
