@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@using InfiniLore.Shared.Auth
@using InfiniLore.Shared.Services.JwtToken
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@rendermode InteractiveServer
@inject IJwtTokenJsSecureStorage JsTokenProvider
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html *@
@* ------------------------------------------------------------------------------------------------------------------ *@
<SideNavMenu @bind-MenuCollapsed="@MenuCollapsed" Size="SideNavMenuSize.Large">
    <Header>
        <a href="/"
           class="@(!MenuCollapsed ? "text-1xl font-bold text-(--color-base-00) hover:text-(--color-accent) no-underline" : "hidden")">
            InfiniLore
        </a>
    </Header>

    <Body>
    <SideNavMenuLink Href="/about">
        <Icon>
            <LiEqualApproximately/>
        </Icon>
        <Text>About</Text>
    </SideNavMenuLink>

    <SideNavMenuLink Href="/api-test">
        <Icon>
            <LiPlus/>
        </Icon>
        <Text>Api Test</Text>
    </SideNavMenuLink>

    <SideNavMenuLink Href="/lorescopes">
        <Icon>
            <LiSignature/>
        </Icon>
        <Text>LoreScopes</Text>
    </SideNavMenuLink>

    <AuthorizeView>
        <NotAuthorized></NotAuthorized>
        <Authorized>
            <SideNavMenuLink Href="/claims-viewer">
                <Icon>
                    <LiView/>
                </Icon>
                <Text>Claims viewer</Text>
            </SideNavMenuLink>
        </Authorized>
    </AuthorizeView>

    </Body>

    <Footer>
        <AuthorizeView>
            <NotAuthorized>
                <SideNavMenuLink Href="Account/Login?redirectUri=/">
                    <Icon>
                        <LiKeyRound class="@($"transition-all duration-300 {(MenuCollapsed ? "opacity-100" : "opacity-0")}")"/> 
                    </Icon>
                    <Text>Login</Text>
                </SideNavMenuLink>
                <SideNavMenuLink Href="Account/Login?redirectUri=/">
                    <Icon>
                        <LiSignpost class="@($"transition-all duration-300 {(MenuCollapsed ? "opacity-100" : "opacity-0")}")"/>
                    </Icon>
                    <Text>SignUp</Text>
                </SideNavMenuLink>
            </NotAuthorized>

            <Authorized>
                <!-- Profile Icon -->
                <SideNavMenuUser
                    HrefUserProfile="/account/profile"
                    UserName="@UserName"
                    UserImageUrl="@ProfileImage">
                    <AdditionalLinks>
                        <NavLink @onclick="LogoutCallbackAsync"
                                 href="/account/logout"
                                 class="@(SideNavMenuUser.AdditionalLinkClasses)">
                            logout
                        </NavLink>
                    </AdditionalLinks>
                </SideNavMenuUser>
            </Authorized>
        </AuthorizeView>
    </Footer>
</SideNavMenu>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    // Cascading authentication state
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // State for user details
    private string UserName { get; set; } = "Guest";
    private string ProfileImage { get; set; } = "";// Fallback image
    private bool MenuCollapsed { get; set; }// Tracks whether the menu is collapsed

    protected override async Task OnInitializedAsync() {
        if (AuthenticationStateTask is null) return;

        AuthenticationState authState = await AuthenticationStateTask;
        ClaimsPrincipal user = authState.User;

        if (user.Identity is { IsAuthenticated: true }) {
            // Retrieve claims
            string? nameClaim = user.FindFirst(c => c.Type == InfiniLoreClaimsStoreConstants.UserName)?.Value
                ?? user.FindFirst(c => c.Type == "name")?.Value
                ?? user.FindFirst(c => c.Type == ClaimTypes.Name)?.Value;

            string? imageClaim = user.FindFirst(c => c.Type.Equals("picture"))?.Value;

            // Set username and profile image
            UserName = nameClaim ?? "User";
            ProfileImage = imageClaim ?? string.Empty;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LogoutCallbackAsync() {
        await JsTokenProvider.RemoveTokenAsync();
    }
}
