@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@using AterraEngine.Unions
@using InfiniLore.InfiniBlazor.Theming
@using InfiniLore.Modules.Core.Shared
@using InfiniLore.Modules.Core.Shared.Database
@using InfiniLore.Shared.Auth
@using InfiniLore.Shared.Services.JwtToken
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@rendermode InteractiveServer
@inject IJwtTokenJsSecureStorage JsTokenProvider
@inject IThemeSelector ThemeSelector
@inject IInteractiveApiUsers UserInteractiveApi
@inject NavigationManager NavigationManager
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html *@
@* ------------------------------------------------------------------------------------------------------------------ *@
<SideNavMenu @bind-MenuCollapsed="@MenuCollapsed" Size="SideNavMenuSize.Large">
    <Header>
        <a href="/"
           class="@(!MenuCollapsed ? "text-1xl font-bold text-(--color-base-00) hover:text-(--color-accent) no-underline" : "hidden")">
            InfiniLore
        </a>
    </Header>

    <Body>
        <SideNavMenuLink Href="/about">
            <Icon><LiEqualApproximately/></Icon>
            <Text>About</Text>
        </SideNavMenuLink>

        <AuthorizeView>
            <NotAuthorized></NotAuthorized>
            <Authorized>
                <SideNavMenuLink Href="/api-test">
                    <Icon><LiPlus/></Icon>
                    <Text>Api Test</Text>
                </SideNavMenuLink>

                <SideNavMenuLink Href="/lorescopes">
                    <Icon><LiSignature/></Icon>
                    <Text>LoreScopes</Text>
                </SideNavMenuLink>
                
                <SideNavMenuLink Href="/claims-viewer">
                    <Icon><LiView/></Icon>
                    <Text>Claims viewer</Text>
                </SideNavMenuLink>
            </Authorized>
        </AuthorizeView>
    </Body>

    <Footer>
        <AuthorizeView>
            <NotAuthorized>
                <SideNavMenuLink Href="Account/Login?redirectUri=/">
                    <Icon>
                        <LiKeyRound class="@($"transition-all duration-300 {(MenuCollapsed ? "opacity-100" : "opacity-0")}")"/>
                    </Icon>
                    <Text>Login</Text>
                </SideNavMenuLink>
                <SideNavMenuLink Href="Account/Login?redirectUri=/">
                    <Icon>
                        <LiSignpost class="@($"transition-all duration-300 {(MenuCollapsed ? "opacity-100" : "opacity-0")}")"/>
                    </Icon>
                    <Text>SignUp</Text>
                </SideNavMenuLink>
            </NotAuthorized>

            <Authorized>
                <SideNavMenuLink Href="/swagger">
                    <Icon><LiBraces/></Icon>
                    <Text>Swagger</Text>
                </SideNavMenuLink>
                
                <!-- Profile Icon -->
                <SideNavMenuUser
                    HrefUserProfile="/account/profile"
                    UserName="@UserModel.Username">
                    <Icon>
                        <UserIcon
                            HrefUserProfile="/account/profile"
                            ImageUrl="@UserModel.ProfileImageUrl"/>
                    </Icon>
                    <AdditionalLinks>
                        <button class="@(SideNavMenuUser.AdditionalLinkClasses)" @onclick="OnThemeSwitchAsync">
                            theme
                        </button>

                        <NavLink @onclick="LogoutCallbackAsync"
                                 href="/account/logout"
                                 class="@(SideNavMenuUser.AdditionalLinkClasses)">
                            logout
                        </NavLink>
                    </AdditionalLinks>
                </SideNavMenuUser>
            </Authorized>
        </AuthorizeView>
    </Footer>
</SideNavMenu>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    // Cascading authentication state
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // State for user details
    private bool MenuCollapsed { get; set; } // Tracks whether the menu is collapsed
    private IInfiniLoreUserModel UserModel { get; set; } = new DefaultInfiniLoreUserModel();
    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        if (AuthenticationStateTask is null) return;

        AuthenticationState authState = await AuthenticationStateTask;
        ClaimsPrincipal user = authState.User;
        
        if (user.Identity is { IsAuthenticated: true }) {
            // try find userId
            string? userId = user.FindFirstValue(InfiniLoreClaimsStoreConstants.UserId);
            if (userId is null) {
                await JsTokenProvider.RemoveTokenAsync();
                NavigationManager.NavigateTo("/account/logout");
                return;
            }

            Result<IInfiniLoreUserModel> result = await UserInteractiveApi.GetUserAsync(userId);
            if (!result.TryGetAsSuccess(out IInfiniLoreUserModel? userModel)) {
                await JsTokenProvider.RemoveTokenAsync();
                NavigationManager.NavigateTo("/account/logout");
                return;
            }

            UserModel = userModel;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LogoutCallbackAsync() {
        await JsTokenProvider.RemoveTokenAsync();
    }

    private async Task OnThemeSwitchAsync() {
        await ThemeSelector.TrySelectNextThemeModeAsync();
    }
}
