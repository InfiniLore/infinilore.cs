@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html *@
@* ------------------------------------------------------------------------------------------------------------------ *@
<!-- Sidebar -->
<aside class="bg-gray-800 h-full p-4 flex flex-col space-y-4 fixed w-48">
    <!-- Top Left Logo -->
    <div class="flex items-center justify-between">
        <a href="/" class="text-2xl font-bold text-white hover:text-gray-300 no-underline">
            InfiniLore
        </a>

        <!-- Hamburger Menu -->
        <button
            class="text-white p-2 rounded hover:bg-gray-700 focus:outline-none"
            @onclick="ToggleMenu">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu">
                <line x1="4" y1="12" x2="20" y2="12"></line>
                <line x1="4" y1="6" x2="20" y2="6"></line>
                <line x1="4" y1="18" x2="20" y2="18"></line>
            </svg>
        </button>
    </div>


    <!-- Navigation -->
    <nav class="flex flex-col space-y-2">
        @* <NavLink href="/" Match="NavLinkMatch.All" class="block px-4 py-2 rounded hover:bg-gray-700"> *@
        @*     Home *@
        @* </NavLink> *@
    </nav>

    <!-- Profile Section -->
    <div class="mt-auto border-t border-gray-600 pt-4">
        <AuthorizeView>
            <Authorized>
                <div class="flex items-center space-x-4">
                    <!-- Profile Icon/Avatar -->
                    <img src="@ProfileImage" alt="Profile" class="w-8 h-8 rounded-full">
                    <!-- User Info -->
                    <div class="text-white">
                        <p class="font-semibold">@UserName</p>
                        <a href="/account/profile" class="text-sm text-gray-400 hover:text-gray-200">Account Settings</a>
                    </div>
                </div>
                <NavLink href="account/logout" class="block mt-4 px-4 py-2 rounded text-red-500 hover:bg-gray-700">
                    Logout
                </NavLink>
            </Authorized>
            <NotAuthorized>
                <a href="Account/Login?redirectUri=/">Log in</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</aside>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code *@
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string UserName { get; set; } = "Guest";
    private string ProfileImage { get; set; } = "";// Fallback image

    protected override async Task OnInitializedAsync() {
        if (AuthenticationStateTask is null) return;

        AuthenticationState authState = await AuthenticationStateTask;
        ClaimsPrincipal user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated) {
            // Retrieve claims
            string? nameClaim = user.FindFirst(c => c.Type == "name")?.Value ??
                user.FindFirst(c => c.Type == ClaimTypes.Name)?.Value;
            string? imageClaim = user.FindFirst(c => c.Type.Equals("picture"))?.Value;

            // Set username and profile image
            UserName = nameClaim ?? "User";
            ProfileImage = imageClaim ?? ""; // Fallback if no image is available
        }
    }

    private Task ToggleMenu() {
        throw new NotImplementedException();
    }
}