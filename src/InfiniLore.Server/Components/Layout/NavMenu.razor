@using InfiniLore.ServerClient.Shared
@using InfiniLore.ServerClient.Shared.JwtToken
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@rendermode InteractiveServer
@inject IJwtTokenJsSecureStorage JsTokenProvider
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html *@
@* ------------------------------------------------------------------------------------------------------------------ *@
<SideNavMenu @bind-MenuCollapsed="@MenuCollapsed">
    <Header>
        <a href="/"
           class="@(!MenuCollapsed ? "text-2xl font-bold text-white hover:text-gray-300 no-underline" : "hidden")">
            InfiniLore
        </a>
    </Header>

    <Body>
        <SideNavMenuLink Href="/about">
            <Icon>
                <LiEqualApproximately/>
            </Icon>
            <Text>About</Text>
        </SideNavMenuLink>

        <SideNavMenuLink Href="/api-test">
            <Icon>
                <LiPlus/>
            </Icon>
            <Text>Api Test</Text>
        </SideNavMenuLink>

        <SideNavMenuLink Href="/markdown-test">
            <Icon>
                <LiSignature/>
            </Icon>
            <Text>Markdown Test</Text>
        </SideNavMenuLink>

        <AuthorizeView>
            <NotAuthorized></NotAuthorized>
            <Authorized>
                <SideNavMenuLink Href="/claims-viewer">
                    <Icon>
                        <LiView/>
                    </Icon>
                    <Text>Claims</Text>
                </SideNavMenuLink>
            </Authorized>
        </AuthorizeView>

    </Body>

    <Footer>
        <AuthorizeView>
            <NotAuthorized>
                <NavLink href="Account/Login?redirectUri=/">Log in</NavLink>
            </NotAuthorized>

            <Authorized>
                <!-- Profile Icon -->
                <div class="w-full flex flex-nowrap items-center justify-left gap-1">
                    
                    <NavLink href="/account/profile" class="w-12 h-12  flex-shrink-0">
                        @if (!string.IsNullOrEmpty(ProfileImage)) {
                            <img src="@ProfileImage" alt="Profile" class="rounded-full" crossorigin="anonymous">
                        } else {
                            <LucideIcon Name="user" class="w-full h-full text-gray-400"/>
                        }

                    </NavLink>
                    <!-- User Info -->
                    <div class="@($"{(MenuCollapsed ? "w-0 opacity-0 delay-0" : "delay-300 w-auto ml-2 opacity-100")}") text-black flex flex-col space-y-1">
                        <a href="/account/profile" class="font-semibold">@UserName</a>

                        @* TODO Make it so that when the logout is pressed, we also remove the api token from storage *@
                        <NavLink @onclick="LogoutCallbackAsync" href="/account/logout"
                                 class="text-sm text-black hover:text-gray-200 hover:font-bold">logout
                        </NavLink>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </Footer>
</SideNavMenu>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code *@
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    // Cascading authentication state
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // State for user details
    private string UserName { get; set; } = "Guest";
    private string ProfileImage { get; set; } = "";// Fallback image
    private bool MenuCollapsed { get; set; } // Tracks whether the menu is collapsed
    private bool _imageLoadFailed;

    protected override async Task OnInitializedAsync() {
        if (AuthenticationStateTask is null) return;

        AuthenticationState authState = await AuthenticationStateTask;
        ClaimsPrincipal user = authState.User;

        if (user.Identity is { IsAuthenticated: true }) {
            // Retrieve claims
            string? nameClaim = user.FindFirst(c => c.Type == InfiniLoreClaimsStoreConstants.UserName)?.Value
                ?? user.FindFirst(c => c.Type == "name")?.Value
                ?? user.FindFirst(c => c.Type == ClaimTypes.Name)?.Value;

            string? imageClaim = user.FindFirst(c => c.Type.Equals("picture"))?.Value;

            // Set username and profile image
            UserName = nameClaim ?? "User";
            ProfileImage = imageClaim ?? "";// Fallback if no image is available
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LogoutCallbackAsync() {
        await JsTokenProvider.RemoveTokenAsync();
    }
    
    private async Task HandleImageError()
    {
        _imageLoadFailed = true;
        await InvokeAsync(StateHasChanged);
    }

}
