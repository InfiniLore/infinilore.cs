@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using InfiniLore.Server.Components.ComponentLibrary
@using InfiniLore.Server.Services.Auth0
@using InfiniLore.ServerClient.Shared.JwtToken
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@rendermode InteractiveServer
@inject IJsSecureStorageJwtTokenProvider JsTokenProvider
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html *@
@* ------------------------------------------------------------------------------------------------------------------ *@
<CollapsibleMenu @bind-IsMenuCollapsed="@IsMenuCollapsed">
    <Header>
        <a href="/" 
           class="@(!IsMenuCollapsed ? "text-2xl font-bold text-white hover:text-gray-300 no-underline" : "hidden")">
            InfiniLore
        </a>
    </Header>
    
    <NavigationMenu>
        <CollapsibleMenuButton Href="/about" LucideIcon="equal-approximately">About</CollapsibleMenuButton>
        <CollapsibleMenuButton Href="/counter" LucideIcon="plus">counter</CollapsibleMenuButton>

        <AuthorizeView>
            <NotAuthorized></NotAuthorized>
            <Authorized>
                <CollapsibleMenuButton Href="/claims-viewer" LucideIcon="view">Claims</CollapsibleMenuButton>
            </Authorized>
        </AuthorizeView>
        
    </NavigationMenu>
    
    <Footer>
        <AuthorizeView>
            <NotAuthorized>
                <NavLink href="Account/Login?redirectUri=/">Log in</NavLink>
            </NotAuthorized>

            <Authorized>
                <!-- Profile Icon -->
                <NavLink href="/account/profile"
                         class="@($"transition-all duration-300 {(IsMenuCollapsed ? "w-8 h-8 mx-auto" : "w-10 h-10")}")">
                    @if (!string.IsNullOrEmpty(ProfileImage)) {
                        <img src="@ProfileImage" alt="Profile" class="rounded-full" crossorigin="anonymous">
                    }
                    else {
                        <LucideIcon Name="user" class="w-full h-full text-gray-400"/>
                    }

                </NavLink>
                <!-- User Info -->
                <div class="@(!IsMenuCollapsed ? "ml-4" : "hidden") text-white flex flex-col space-y-1">
                    <p class="font-semibold">@UserName</p>

                    <NavLink href="/account/profile" class="text-sm text-gray-400 hover:text-gray-200">settings</NavLink>
                    
                    @* TODO Make it so that when the logout is pressed, we also remove the api token from storage *@
                    <NavLink @onclick="LogoutCallbackAsync" href="/account/logout" class="text-sm text-gray-400 hover:text-gray-200">logout</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </Footer>
</CollapsibleMenu>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code *@
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    // Cascading authentication state
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // State for user details
    private string UserName { get; set; } = "Guest";
    private string ProfileImage { get; set; } = "";// Fallback image
    private bool IsMenuCollapsed { get; set; } = false;// Tracks whether the menu is collapsed

    protected override async Task OnInitializedAsync() {
        if (AuthenticationStateTask is null) return;

        AuthenticationState authState = await AuthenticationStateTask;
        ClaimsPrincipal user = authState.User;

        if (user.Identity is { IsAuthenticated: true }) {
            // Retrieve claims
            string? nameClaim = user.FindFirst(c => c.Type == ClaimsStore.InfiniloreUserName)?.Value
                ?? user.FindFirst(c => c.Type == "name")?.Value
                ?? user.FindFirst(c => c.Type == ClaimTypes.Name)?.Value;

            string? imageClaim = user.FindFirst(c => c.Type.Equals("picture"))?.Value;

            // Set username and profile image
            UserName = nameClaim ?? "User";
            ProfileImage = imageClaim ?? "";// Fallback if no image is available
        }
        
        await InvokeAsync(StateHasChanged);
    }
    
    private async Task LogoutCallbackAsync() {
        await JsTokenProvider.RemoveTokenAsync();
    }
}
