@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/account/register"
@rendermode InteractiveServer
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniPage>
    <InfiniSection class="w-full tails-selected-element">
        <InfiniHeading4>Finishing Signup</InfiniHeading4>
        <p class="text-sm text-(--color-base-30)">
            We just need a little bit more information about you before you can start exploring
        </p>

        <InfiniSpacer/>

        <label class="font-medium">
            Username
        </label>
        <InfiniTextInput
            @bind-Value="@userModel.Username"
            ValidationMessage="@_usernameValidationMessage"
            OnValidSubmit="@OnUsernameInputAsync"
            Label="Username"
            Placeholder="Enter Your New UserName"
        />

        <InfiniSpacer/>
        <div class="flex justify-center w-full">
            <InfiniButton
                OnClick="@HandleValidSubmitAsync"
                Variant="ButtonVariant.Primary"
                Disabled="@_isFormDisabled">
                Submit
            </InfiniButton>
        </div>
    </InfiniSection>
</InfiniPage>
