@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using AterraEngine.Unions
@using InfiniLore.Server.Services.CQRS
@using InfiniLore.Server.Services.CQRS.Commands.Account
@using InfiniLore.Server.Services.CQRS.Queries.Account
@using MediatR
@using System.ComponentModel.DataAnnotations
@using System.Diagnostics
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/account/register"
@inject NavigationManager Navigation
@inject IMediator Mediator
@rendermode InteractiveServer
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<h3>Register</h3>
<p>User ID: @Auth0UserId</p>

<EditForm Model="@userModel" OnValidSubmit="HandleValidSubmitAsync">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

    <div>
        <label for="username">Username:</label>
        <InputText id="username" @bind-Value="userModel.Username" @oninput="OnUsernameInputAsync" class="form-control"/>
        <ValidationMessage For="@(() => userModel.Username)"/>
        @if (!string.IsNullOrEmpty(_usernameValidationMessage)) {
            <span class="text-danger">@_usernameValidationMessage</span>
        }
        @switch (_usernameStatus) {
            case UsernameStatus.Checking:
                <span class="text-warning">Checking...</span>
                break;
            case UsernameStatus.Taken:
                <span class="text-danger">Username is already taken.</span>
                break;
            case UsernameStatus.Available:
                <span class="text-success">Username is available!</span>
                break;
            case UsernameStatus.None: break;
            default: throw new ArgumentOutOfRangeException();
        }

    </div>

    <button type="submit" class="btn btn-primary" disabled="@_isFormDisabled">Register</button>
</EditForm>


@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "auth0UserId")]
    public string Auth0UserId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string ReturnUrl { get; set; } = string.Empty;

    private readonly UserModel userModel = new();

    private class UserModel {
        [Required]
        [StringLength(50, ErrorMessage = "Username must be less than 50 characters.")]
        public string Username { get; set; } = string.Empty;
    }

    private string _usernameValidationMessage = string.Empty;
    private bool _isFormDisabled;
    private readonly Stopwatch _debounceStopwatch = new();
    private const int DebounceMilliseconds = 500;
    private UsernameStatus _usernameStatus = UsernameStatus.None;


    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    private async Task OnUsernameInputAsync(ChangeEventArgs e) {
        if (!_debounceStopwatch.IsRunning) {
            _debounceStopwatch.Start();
        } else {
            _debounceStopwatch.Restart();
        }

        // Set status to "Checking" while waiting for debounce
        _usernameValidationMessage = string.Empty;
        _usernameStatus = UsernameStatus.Checking;
        await InvokeAsync(StateHasChanged);

        // Debounced validation logic
        await Task.Delay(DebounceMilliseconds);
        if (_debounceStopwatch.ElapsedMilliseconds >= DebounceMilliseconds) {
            _debounceStopwatch.Stop();
            await ValidateUsernameAsync(userModel.Username);
        }
    }

    private async Task ValidateUsernameAsync(string username) {
        if (string.IsNullOrWhiteSpace(username)) {
            _usernameValidationMessage = "Username cannot be empty.";
            _isFormDisabled = true;
            _usernameStatus = UsernameStatus.None;
        
            await InvokeAsync(StateHasChanged); // Ensure UI updates properly
            return;
        }

        // Call the backend to check username availability
        MediatorResponse<bool> response = await Mediator.Send(new UsernameExistsQuery(username));
        if (!response.TryGetAsSuccess(out bool isTaken)) return;

        // Update the UI based on validation response
        _usernameStatus = isTaken 
            ? UsernameStatus.Taken 
            : UsernameStatus.Available;
        _usernameValidationMessage = string.Empty;
        _isFormDisabled = isTaken;

        await InvokeAsync(StateHasChanged); // Ensure UI updates properly
    }
    
    private async Task HandleValidSubmitAsync() {
        // Ensure username has passed asynchronous validation
        if (_isFormDisabled || !string.IsNullOrEmpty(_usernameValidationMessage)) return;

        MediatorResponse<Guid> result = await Mediator.Send(new UserCreateRequest(Auth0UserId, userModel.Username));
        if (result.TryGetAsError(out Error<string> errorMessage)) {
            _usernameValidationMessage = errorMessage.Value;
            _isFormDisabled = false; // Allow retry
            await InvokeAsync(StateHasChanged);
            return;
        }
        
        string returnUl = ReturnUrl.IsNotNullOrEmpty()
            ? ReturnUrl
            : "/";

        string encodedReturnUl = Uri.EscapeDataString(returnUl);
        Navigation.NavigateTo($"Account/Login?redirectUri={encodedReturnUl}");
    }
    
    private enum UsernameStatus {
        None,
        Checking,
        Taken,
        Available
    }
}