@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using InfiniLore.InfiniBlazor
@using InfiniLore.Modules.Core.Shared
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/claims-viewer"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IHttpContextAccessor HttpContextAccessor
@inject IJsRuntimeHelper JsRuntimeHelper
@inject IJwtTokenEncoder JwtTokenEncoder
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniPage Title="Claims Viewer" Class="p-4">
    @if (_user is not null) {
        <InfiniSection Class="gap-2 w-full grow shrink-0">
            <InfiniHeading3>Claims Viewer</InfiniHeading3>
            
            <p class="text-lg">
                <strong>Authenticated User:</strong> @_user.Identity?.Name
            </p>

            <InfiniTable TItem="Claim" Items="@_user.Claims">
                <Header>
                    <InfiniTableHeader Class="w-min-128 flex flex-col items-center">
                        <span>Actions</span>
                        <div class="flex flex-row gap-3.5 text-(--color-base-40)">
                            <span>Copy Type</span>
                            <span>Copy Value</span>
                        </div>
                    </InfiniTableHeader>
                    <InfiniTableHeader>Claim Type</InfiniTableHeader>
                    <InfiniTableHeader>Claim Value</InfiniTableHeader>
                </Header>
                <Content Context="claim">

                    <InfiniTableCell Alignment="Alignment.Right" Class="flex justify-center gap-6 w-min-128">
                        <InfiniButton
                            IconName="copy"
                            OnClick="@(async () => await CopyToClipboardAsync(claim.Type))"
                            TooltipAnchor="Anchor.Bottom | Anchor.Left"
                            Tooltip="Copy Type"/>
                        <InfiniButton
                            IconName="copy"
                            OnClick="@(async () => await CopyToClipboardAsync(claim.Value))"
                            TooltipAnchor="Anchor.Bottom | Anchor.Left"
                            Tooltip="Copy Value"/>
                    </InfiniTableCell>
                    <InfiniTableCell>@claim.Type</InfiniTableCell>
                    <InfiniTableCell>@claim.Value</InfiniTableCell>
                </Content>
            </InfiniTable>

        </InfiniSection>

        <InfiniSection Class="w-full shrink-0 ">
            <InfiniHeading3>Access Token Viewer</InfiniHeading3>
            
            <div class="flex grow flex-col gap-2">
                <div class="flex grow flex-row gap-4 justify-between w-full items-start ">
                    <!-- Access Token Section -->
                    <div class="flex grow shrink-0 flex-col w-[calc(50%-0.5rem)] gap-2">
                        <InfiniHeading5>Original JWT</InfiniHeading5>
                        @* ReSharper disable once Asp.Entity *@
                        <InfiniCodeBlock 
                            Language="base64"
                            Class="mt-8 bg-(--color-base-70) break-words [&_pre]:whitespace-pre-wrap" 
                            Content="@_accessToken"/>
                    </div>

                    <!-- JWT Viewer Section -->
                    <div class="flex grow flex-col w-[calc(50%-0.5rem)]">
                        <InfiniHeading5>Decoded JWT Details</InfiniHeading5>

                        <div class="flex flex-col gap-2">
                            <!-- Header Section -->
                            <div class="w-full flex flex-col gap-2">
                                <InfiniHeading6 Class="text-(--color-base-30)">Header</InfiniHeading6>
                                @if (!string.IsNullOrWhiteSpace(_header)) {
                                    <InfiniCodeBlock Language="json" Content="@_header"/>
                                }
                                else {
                                    <p class="text-(--color-base-30) italic">Header not available</p>
                                }
                            </div>
                            
                            <!-- Payload Section -->
                            <div class="w-full flex flex-col gap-2">
                                <InfiniHeading6 Class="text-(--color-base-30)">Payload</InfiniHeading6>

                                @if (!string.IsNullOrWhiteSpace(_decodedPayload)) {
                                    <InfiniCodeBlock Language="json" Content="@_decodedPayload"/>
                                }
                                else {
                                    <p class="text-(--color-base-30) italic">Payload not available</p>
                                }
                            </div>

                            <!-- Signature Section -->
                            <div class="w-full flex flex-col gap-2 mt-2">
                                <InfiniHeading6 Class="text-(--color-base-30)">Signature</InfiniHeading6>
                                @if (!string.IsNullOrWhiteSpace(_signature)) {
                                    <InfiniCodeBlock Language="base64" Content="@_signature"/>
                                }
                                else {
                                    <p class="text-(--color-base-30) italic">Signature not available</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <InfiniSpacer Spacing="Size.M"/>
        </InfiniSection>
    }
</InfiniPage>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    private ClaimsPrincipal? _user;
    private string? _accessToken;
    private string? _header;
    private string? _decodedPayload;
    private string? _signature;

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _user = authState.User;

        if (HttpContextAccessor.HttpContext != null) {
            _accessToken = await HttpContextAccessor.HttpContext.GetTokenAsync("access_token");

            if (!string.IsNullOrWhiteSpace(_accessToken)) {
                if (JwtTokenEncoder.TryDecodeJwtHeader(_accessToken, out string? header)) {
                    _header = header;
                }

                if (JwtTokenEncoder.TryDecodeJwtPayload(_accessToken, out string? payload)) {
                    _decodedPayload = payload;
                }

                if (JwtTokenEncoder.TryGetJwtSignature(_accessToken, out string? signature)) {
                    _signature = signature;
                }
            }
        }
    }

    private async Task CopyToClipboardAsync(string? value) {
        if (!string.IsNullOrWhiteSpace(value)) {
            await JsRuntimeHelper.WriteToClipboardAsync(value);
        }
    }
}