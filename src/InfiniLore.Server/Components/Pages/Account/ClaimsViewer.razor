@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/claims-viewer"
@using InfiniLore.Server.Services
@using InfiniLore.Shared.Services.JwtToken
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IHttpContextAccessor HttpContextAccessor
@inject ClipboardService ClipboardService
@attribute [Authorize]
@rendermode InteractiveServer
@inject IJwtTokenEncoder JwtTokenEncoder
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<h3 class="text-2xl font-bold text-gray-800 mb-4">Claims Viewer</h3>

@if (_user != null) {
    <p class="text-lg">
        <strong>Authenticated User:</strong> @_user.Identity?.Name
    </p>

    <table class="table-auto border-collapse border border-gray-200 w-full mt-4">
        <thead>
        <tr class="bg-gray-100 text-gray-800">
            <th class="border border-gray-200 px-4 py-2 text-left">Claim Type</th>
            <th class="border border-gray-200 px-4 py-2 text-left">Claim Value</th>
            <th class="border border-gray-200 px-4 py-2">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (Claim? claim in _user.Claims) {
            <tr>
                <td class="border border-gray-200 px-4 py-2">@claim.Type</td>
                <td class="border border-gray-200 px-4 py-2">@claim.Value</td>
                <td class="border border-gray-200 px-4 py-2 text-center">
                    <button
                        class="bg-blue-500 hover:bg-blue-600 active:bg-blue-700 text-white px-3 py-1 rounded shadow transition duration-200"
                        @onclick="async () => await CopyToClipboardAsync(claim.Value)">
                        Copy
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <br>
    <h4 class="text-xl font-semibold text-gray-800 mb-2">Access Token Viewer</h4>
    <div class="flex flex-row space-x-4 w-full items-start">
        <!-- Access Token Section -->
        <div class="w-1/2">
            <h5 class="text-lg font-medium text-gray-700 mb-2">Original JWT</h5>
            <p class="bg-gray-100 border border-gray-300 rounded px-4 py-2 break-words whitespace-pre-wrap h-72 overflow-auto">@_accessToken</p>
            <div class="flex justify-center mt-2">
                <button
                    class="bg-green-500 hover:bg-green-600 active:bg-green-700 text-white px-4 py-2 rounded outline outline-2 outline-green-700 shadow transition duration-200"
                    @onclick="async () => await CopyToClipboardAsync(_accessToken)">
                    Copy Access Token
                </button>
            </div>
        </div>

        <!-- JWT Viewer Section -->
        <div class="w-full">
            <h5 class="text-lg font-medium text-gray-700 mb-2">Decoded JWT Details</h5>

            <!-- Header Section -->
            <div>
                <h6 class="font-semibold text-gray-600 mb-1">Header</h6>
                @if (!string.IsNullOrWhiteSpace(_header)) {
                    <pre class="bg-gray-50 border text-sm border-gray-200 rounded p-4 overflow-auto">@_header</pre>
                } else {
                    <p class="text-gray-600 italic">Header not available</p>
                }
            </div>

            <!-- Payload Section -->
            <div class="mt-4">
                <h6 class="font-semibold text-gray-600 mb-1">Payload</h6>
                @if (!string.IsNullOrWhiteSpace(_decodedPayload)) {
                    <pre
                        class="bg-gray-50 border text-sm border-gray-200 rounded p-4 overflow-auto">@_decodedPayload</pre>
                } else {
                    <p class="text-gray-600 italic">Payload not available</p>
                }
            </div>

            <!-- Signature Section -->
            <div class="mt-4">
                <h6 class="font-semibold text-gray-600 mb-1">Signature</h6>
                @if (!string.IsNullOrWhiteSpace(_signature)) {
                    <pre class="bg-gray-50 text-sm border border-gray-200 rounded p-4 overflow-auto">@_signature</pre>
                } else {
                    <p class="text-gray-600 italic">Signature not available</p>
                }
            </div>
        </div>
    </div>
} else {
    <p class="text-gray-600">Loading user information...</p>
}

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private ClaimsPrincipal? _user;
    private string? _accessToken;
    private string? _header;
    private string? _decodedPayload;
    private string? _signature;

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _user = authState.User;

        if (HttpContextAccessor.HttpContext != null) {
            _accessToken = await HttpContextAccessor.HttpContext.GetTokenAsync("access_token");

            if (!string.IsNullOrWhiteSpace(_accessToken)) {
                if (JwtTokenEncoder.TryDecodeJwtHeader(_accessToken, out string? header)) {
                    _header = header;
                }

                if (JwtTokenEncoder.TryDecodeJwtPayload(_accessToken, out string? payload)) {
                    _decodedPayload = payload;
                }

                if (JwtTokenEncoder.TryGetJwtSignature(_accessToken, out string? signature)) {
                    _signature = signature;
                }
            }
        }
    }

    private async Task CopyToClipboardAsync(string? value) {
        if (!string.IsNullOrWhiteSpace(value)) {
            await ClipboardService.WriteTextAsync(value);
        }
    }
}