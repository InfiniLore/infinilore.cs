@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using InfiniLore.Modules.Core.Shared
@using InfiniLore.Modules.Core.Shared.Database
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/account/profile"
@rendermode InteractiveServer

@attribute [Authorize]
@inject IInteractiveApiUsers UserInteractiveApi
@inject ILogger<Profile> Logger
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniPage Title="Profile">
    <InfiniSection>
        <InfiniHeading3>
            Profile Settings
            <span class="text-sm text-(--color-base-50)">
                Id: @UserModel.Id
            </span>
        </InfiniHeading3>

        <div class="flex flex-row gap-2">
            @* User Data *@
            <div class="flex w-2/3 grow flex-col gap-2">
                <span>UserName: <span class="text-xs">@UserModel.Username</span></span>

                <div class="flex flex-col grow justify-center">
                    <div class="grow"></div>
                    <div class="flex flex-row justify-between">
                        <span>Profile Image: </span>
                    </div>
                    <div class="flex flex-row justify-between">
                        <div class="relative">
                            <InputFile OnChange="@OnPosterImageSelected"
                                       class="w-full text-sm text-(--color-base-30) transition-all duration-150 transform cursor-pointer
                         file:cursor-pointer active:file:scale-95 file:mr-4 file:px-2 file:py-1 
                         file:text-base file:rounded-md file:bg-(--color-base-70) file:text-(--color-base-00) 
                         hover:file:text-(--color-accent) hover:file:ring-2 hover:ring-(--color-accent) 
                         hover:file:scale-105 p-1"
                                       accept="image/*"/>
                        </div>

                        <InfiniButton OnClick="OnPosterImageUpload" Disabled="@(SelectedFile is null)" IconName="check"/>
                    </div>
                </div>

            </div>

            @* Profile Image *@
            <div class="w-1/3 min-w-[120px]">
                <div class="aspect-square w-full">
                    <img
                        class="w-full h-full rounded-full object-cover"
                        src="@UserModel.ProfileImageUrl"
                        alt="profile image"/>
                </div>
            </div>
        </div>
    </InfiniSection>

    <AuthorizeView Roles="@RolesStoreConstants.InfiniloreAdmin">
        <Authorized>
            <div class="my-8"></div>
            <InfiniSection>
                <InfiniHeading3>Admin Dashboard</InfiniHeading3>
                Under Development ... 
            </InfiniSection>
        </Authorized>
    </AuthorizeView>
</InfiniPage>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;
    private IInfiniLoreUserModel UserModel { get; set; } = new DefaultInfiniLoreUserModel();
    private IBrowserFile? SelectedFile { get; set; }
    private const int MaxFileSize = 5 * 1024 * 1024; // 5MB in bytes

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        AuthenticationState state = await AuthenticationStateTask;
        ClaimsPrincipal user = state.User;
        if (user.Identity is { IsAuthenticated: true }) {
            // try find userId
            string? userId = user.FindFirstValue(InfiniLoreClaimsStoreConstants.UserId);
            if (userId.IsNullOrEmpty()) return;
            
            Outcome<IInfiniLoreUserModel> outcome = await UserInteractiveApi.GetUserAsync(userId);
            if (!outcome.TryGetAsData(out IInfiniLoreUserModel? userModel)) return;

            UserModel = userModel;
        }

        await base.OnInitializedAsync();
    }
    
    private void OnPosterImageSelected(InputFileChangeEventArgs e) {
        if (e.File is not {} file) return;
        SelectedFile = file;
        StateHasChanged();
    }
    
    private async Task OnPosterImageUpload() {
        if (SelectedFile is null) return;

        try {
            // 5MB limit
            if (SelectedFile.Size > MaxFileSize) {
                Logger.Warning("File size exceeds 5MB limit");
                return;
            }
            
            // Copy to MemoryStream first
            Outcome outcome = await UserInteractiveApi.UpsertProfileImageAsync(
                UserModel.Id.ToString(),
                SelectedFile
            );

            if (!outcome.TryGetAsState(out bool success) || !success ) {
                Logger.Error("Failed to upload image");
                return;
            }

            // Refresh the LoreScope model to get the updated image URL
            await OnInitializedAsync();
            SelectedFile = null;
        }
        finally {
            StateHasChanged();
        }
    }
}