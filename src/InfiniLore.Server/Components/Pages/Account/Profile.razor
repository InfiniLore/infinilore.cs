@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/account/profile"
@using InfiniLore.Server.Components.Layout
@using InfiniLore.Shared.Auth
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer

@attribute [Authorize]
@layout MainLayout
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>Profile</PageTitle>

<InfiniSection>
    <div class="row">
        <div class="col-md-12">
            <div class="row">
                <h2 class="text-lg font-semibold text-(--color-base-90)">
                    Profile
                </h2>

                <div class="col-md-2">
                    <img src="@_picture"
                         alt="" class="img-rounded img-responsive" style="display: block; margin: 0 auto;"/>
                </div>
                <div class="col-md-4">
                    <span>UserName: @_username</span>
                </div>
            </div>
        </div>
    </div>
</InfiniSection>

<AuthorizeView Roles="@RolesStoreConstants.InfiniloreAdmin">
    <Authorized>
        <div class="my-8"></div>
        <InfiniSection>

            <h2 class="text-lg font-semibold text-(--color-base-90)">
                Admin Dashboard
            </h2>
        </InfiniSection>
    </Authorized>
</AuthorizeView>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;
    private string _username = string.Empty;
    private string _picture = string.Empty;

    protected override async Task OnInitializedAsync() {
        AuthenticationState state = await AuthenticationStateTask;

        _username = state.User.Identity?.Name ?? string.Empty;
        _picture = state.User.Claims
            .Where(c => c.Type.Equals("picture"))
            .Select(c => c.Value)
            .FirstOrDefault() ?? string.Empty;

        await base.OnInitializedAsync();
    }
}