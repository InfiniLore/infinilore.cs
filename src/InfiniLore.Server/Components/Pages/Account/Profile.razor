@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using Infinilore.InfiniBlazor
@using InfiniLore.InfiniBlazor
@using InfiniLore.InfiniBlazor.Toasting
@using InfiniLore.Modules.Core.Shared
@using InfiniLore.Modules.Core.Shared.Database
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/account/profile"
@rendermode InteractiveServer

@attribute [Authorize]
@inject IInteractiveApiUsers UserInteractiveApi
@inject ILogger<Profile> Logger
@inject IToastingProvider ToastingProvider
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniPage Title="Profile" Class="justify-between">
    <InfiniSection Class="mt-4">
        <InfiniHeading3>
            Profile Settings
            <span class="text-sm text-(--color-base-50)">
                Id: @UserModel.Id
            </span>
        </InfiniHeading3>

        <div class="flex flex-row gap-2">
            @* User Data *@
            <div class="flex w-2/3 grow flex-col gap-2">
                <InfiniTextInput
                    Label="Username"
                    LabelLocation="LabelLocation.OnTop"
                    Value="@UserModel.Username"
                    Disabled="true"
                />
                
                <InfiniFileInput
                    Label="Profile Image"
                    LabelLocation="LabelLocation.OnTop"
                    OnFilesChanged="OnPosterImageSelected"
                />
                
                <InfiniSpacerVertical Spacing="Size.S"/>
            </div>

            @* Profile Image *@
            <div class="min-w-[120px]">
                <div class="aspect-square max-h-32 max-w-32">
                    <img
                        class="w-full h-full rounded-full object-cover"
                        src="@UserModel.ProfileImageUrl"
                        alt="profile image"/>
                </div>
            </div>
        </div>
                
        <div class="flex w-full justify-center items-center">
            <InfiniButton
                OnClick="OnSaveChangesAsync"
                Color="Color.Green">
                Save Changes
            </InfiniButton>
        </div>
    </InfiniSection>

    <AuthorizeView Roles="@RolesStoreConstants.InfiniloreAdmin">
        <Authorized>
            <InfiniSection EdgeStyle="SectionEdgeStyle.Bottom">
                <InfiniHeading3>Admin Dashboard</InfiniHeading3>
                Under Development ... <br/>
                You only see this because you are an admin...
                
                <InfiniSpacerVertical Spacing="Size.Xxl"></InfiniSpacerVertical>
            </InfiniSection>
        </Authorized>
    </AuthorizeView>
</InfiniPage>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;
    private IInfiniLoreUserModel UserModel { get; set; } = new DefaultInfiniLoreUserModel();
    private IBrowserFile? SelectedFile { get; set; }
    private const int MaxFileSize = 5 * 1024 * 1024; // 5MB in bytes

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        AuthenticationState state = await AuthenticationStateTask;
        ClaimsPrincipal user = state.User;
        
        if (user.Identity is { IsAuthenticated: true }) {
            // try find userId
            string? userId = user.FindFirstValue(InfiniLoreClaimsStoreConstants.UserId);
            if (userId.IsNullOrEmpty()) return;
            
            Outcome<IInfiniLoreUserModel> outcome = await UserInteractiveApi.GetUserAsync(userId);
            if (!outcome.TryGetAsData(out IInfiniLoreUserModel? userModel)) return;

            UserModel = userModel;
        }

        await base.OnInitializedAsync();
    }
    
    private void OnPosterImageSelected(IReadOnlyList<IBrowserFile>? selectedFiles) {
        if (selectedFiles?.FirstOrDefault() is not {} file) {
            SelectedFile = null;
            return;
        }
        SelectedFile = file;
        StateHasChanged();
    }
    
    private async Task OnSaveChangesAsync() {
        await OnPosterImageUpload();
        
        StateHasChanged();
        
        // Refresh the model
        await OnInitializedAsync();
    }
    
    private async Task OnPosterImageUpload() {
        if (SelectedFile is null) return;

        try {
            // 5MB limit
            if (SelectedFile.Size > MaxFileSize) {
                Logger.Warning("File size exceeds 5MB limit");
                return;
            }
            
            // Copy to MemoryStream first
            Outcome outcome = await UserInteractiveApi.UpsertProfileImageAsync(
                UserModel.Id.ToString(),
                SelectedFile
            );

            if (!outcome.TryGetAsState(out bool success) || !success ) {
                Logger.Error("Failed to upload image");
                return;
            }

            var toast = new ToastingData("Profile image updated");
            await ToastingProvider.PublishToastAsync(toast, ToastAppearance.Success);
            SelectedFile = null;
        }
        catch (Exception e) {
            Logger.Warning(e, "Could not update profile image");
            var toast = new ToastingData("Profile image could not be updated");
            await ToastingProvider.PublishToastAsync(toast, ToastAppearance.Error);
        }
    }
}