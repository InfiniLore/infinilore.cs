@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/account/profile"
@using InfiniLore.Server.Components.Layout
@using InfiniLore.Server.Services.CQRS
@using InfiniLore.Server.Services.CQRS.Commands.Data.User
@using InfiniLore.Server.Services.CQRS.Queries.Account
@using InfiniLore.ServerClient.Shared
@using MediatR
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@rendermode InteractiveServer

@attribute [Authorize]
@layout MainLayout
@inject IMediator Mediator
@inject IAuthenticationStateProviderClaimsPrincipalHelper ClaimsPrincipalHelper
@inject ILogger<Profile> Logger
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>Profile</PageTitle>

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <h2>Profile</h2>

            <div class="col-md-2">
                <img src="@_picture"
                     alt="" class="img-rounded img-responsive" style="display: block; margin: 0 auto;"/>
            </div>
            <div class="col-md-4">
                <h3>@_username</h3>
                <p>
                    @* <i class="bi bi-envelope"></i> @_emailAddress *@
                </p>
            </div>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <button @onclick="CreateLorescopeCallbackAsync">Create Lorescope</button>
                    <h3>Admin Dashboard</h3>
                </Authorized>
                <NotAuthorized>
                    <h3>You do not have access to this page.</h3>
                </NotAuthorized>
            </AuthorizeView>

        </div>
    </div>
</div>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;
    private string _username = string.Empty;
    private string _emailAddress = string.Empty;
    private string _picture = string.Empty;

    protected override async Task OnInitializedAsync() {
        AuthenticationState state = await AuthenticationStateTask;

        _username = state.User.Identity?.Name ?? string.Empty;
        _emailAddress = state.User.Claims
            .Where(c => c.Type.Equals(ClaimTypes.Email))
            .Select(c => c.Value)
            .FirstOrDefault() ?? string.Empty;

        _picture = state.User.Claims
            .Where(c => c.Type.Equals("picture"))
            .Select(c => c.Value)
            .FirstOrDefault() ?? string.Empty;

        await base.OnInitializedAsync();
    }

    private async Task CreateLorescopeCallbackAsync(MouseEventArgs args) {
        AuthenticationState state = await AuthenticationStateTask;

        IAuth0Information auth0Info = ClaimsPrincipalHelper.GetAuth0Information(state.User);
        MediatorResponse<Guid> resultUserId = await Mediator.Send(new GetUserIdByAuth0IdQuery(auth0Info.UserId));
        if (!resultUserId.TryGetAsSuccess(out Guid userId)) {
            Logger.Warning($"User could not be found with auth0Id {auth0Info.UserId}");
            return;
        }

        var request = new LoreScopeCreateRequest(userId, Guid.NewGuid().ToString());
        MediatorResponse<Guid> createResult = await Mediator.Send(request);
        if (!createResult.TryGetAsSuccess(out Guid lorescopeId)) {
            Logger.Warning("Something horribly went wrong with creating the lorescope: {err}", createResult.AsError.Value);
            return;
        }

        Logger.Information("LORESCOPE created with id {Id}", lorescopeId);
    }
}