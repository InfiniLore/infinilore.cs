@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using InfiniLore.InfiniBlazor
@using InfiniLore.InfiniBlazor.TextEditor
@using InfiniLore.InfiniBlazor.Toasting
@using InfiniLore.Modules.Core.Shared
@using InfiniLore.Modules.LoreScopes.Shared.Database
@using InfiniLore.Modules.LoreScopes.Shared.KiotaModels
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/lorescope/{LoreScopeId:guid}/settings"
@inject IInteractiveApiLoreScopes LoreScopeInteractiveApi
@inject ILogger<LoreScopeSettings> Logger
@inject NavigationManager NavigationManager
@inject IToastingProvider ToastingProvider
@attribute [Authorize]
@rendermode InteractiveAuto
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniPage Title="LoreScopes Settings" Class="px-4 pb-4">
    <InfiniSection Location="SectionLocation.Top" Class="w-full flex flex-col gap-2">
        <InfiniHeading3 Class="flex flex-row">
            <InfiniButton
                Href="/lorescopes/"
                Variant="ButtonVariant.Transparent"
                IconName="chevron-left"/>

            LoreScope Settings
        </InfiniHeading3>
    </InfiniSection>
    
    <InfiniSection Class="w-full grow">
        <InfiniHeading5>
            LoreScope Details
        </InfiniHeading5>
        
        <InfiniTextInput
            Label="Name"
            Placeholder="Enter a name"
            LabelLocation="LabelLocation.OnTop"
            ValidationMessage="@LoreScopeNameValidationMessage"
            @bind-Value="@LoreScopeModel.Name">
        </InfiniTextInput>

        <InfiniSpacerVertical Spacing="Size.S"/>
        
        <InfiniLabel>Description</InfiniLabel>
        <div class="h-64">
            <InfiniMarkdownEditor
                @bind-Source="@LoreScopeDescriptionSource"
                ShowSidePreview="false"/>
        </div>
        
        <div class="mt-4 w-full">
            <div class="flex flex-row justify-between gap-4">
                <div class="grow w-2/3">
                    <InfiniFileInput 
                        Label="Upload LoreScope Image"
                        LabelLocation="LabelLocation.OnTop"
                        Accept="image/*"
                        AllowMultipleFiles="false"
                        OnFilesChanged="OnPosterImageSelected"/>
                </div>
                <div class="w-1/3 flex justify-center items-center" >
                    <LoreScopePoster ImageUrl="@LoreScopeModel.S3PosterImageUrl" Name="@LoreScopeModel.Name"/>
                </div>

            </div>
        </div>
        
        <InfiniSpacer></InfiniSpacer>
        
        <div class="flex flex-row justify-between">
            <InfiniButton
                Variant="ButtonVariant.Default"
                Color="Color.Green"
                Disabled="IsLoading"
                OnClick="@OnSubmitAsync">Submit</InfiniButton>
            <InfiniButton
                Variant="ButtonVariant.Outline"
                Color="Color.Red"
                IconName="trash"
                Disabled="IsLoading"
                OnClick="@OnDeleteAsync">Delete LoreScope</InfiniButton>
        </div>
        
    </InfiniSection>

</InfiniPage>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    [Parameter] public Guid LoreScopeId { get; set; }
    [SupplyParameterFromQuery(Name = "userId")] public Guid UserId { get; set; }
    
    private ILoreScopeModel _loreScopeModel  = WasmLoreScopeModel.Empty;
    private ILoreScopeModel LoreScopeModel {
        get => _loreScopeModel;
        set {
            _loreScopeModel = value;
            LoreScopeDescriptionSource = new TextSource {
                Text = _loreScopeModel.Description ?? string.Empty
            };
        }
    }

    private IBrowserFile? SelectedFile { get; set; }
    private const int MaxFileSize = 5 * 1024 * 1024; // 5MB in bytes

    private string? LoreScopeNameValidationMessage { get; set; }
    
    private ITextSource LoreScopeDescriptionSource { get; set; } = new TextSource();
    private bool IsLoading { get; set; } = true;

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        if (UserId == Guid.Empty) {
            NavigationManager.NavigateTo("/lorescopes");
            return;
        }
        
        Outcome<ILoreScopeModel> outcome = await LoreScopeInteractiveApi.GetLoreScopeAsync(
            UserId.ToString(),
            LoreScopeId.ToString()
        );
        
        if (!outcome.TryGetAsData(out ILoreScopeModel? model)) {
            NavigationManager.NavigateTo("/lorescopes");
            return;
        }

        LoreScopeModel = model;
        IsLoading = false;
        StateHasChanged();
    }

    private void OnPosterImageSelected(IReadOnlyList<IBrowserFile>? selectedFiles) {
        if (selectedFiles?.FirstOrDefault() is not {} file) {
            SelectedFile = null;
            return;
        }
        SelectedFile = file;
        StateHasChanged();
    }

    private async Task OnSubmitAsync() {
        await Task.WhenAll(
            UploadMetaDataAsync(),
            UploadPosterImageAsync()
        );
        StateHasChanged();
    }
    
    private async Task UploadMetaDataAsync() {
        if (LoreScopeModel.Name.IsNullOrWhiteSpace()) {
            LoreScopeNameValidationMessage = "Name cannot be empty";
            return;
        }

        Outcome outcome = await LoreScopeInteractiveApi.UpdateLoreScopeMetaDataAsync(
            UserId.ToString(),
            LoreScopeId.ToString(),
            LoreScopeModel.Name,
            LoreScopeDescriptionSource.Text
        );
        
        outcome.Switch(
            () => LoreScopeNameValidationMessage = null,
            () => LoreScopeNameValidationMessage = "Could not update LoreScope Name",
            error => LoreScopeNameValidationMessage = error
        );
    }
    
    private async Task UploadPosterImageAsync() {
        if (SelectedFile is null) return;

        try {
            // 5MB limit
            if (SelectedFile.Size > MaxFileSize) {
                Logger.Warning("File size exceeds 5MB limit");
                return;
            }
            
            Outcome outcome = await LoreScopeInteractiveApi.UpsertLoreScopeImageAsync(
                UserId.ToString(),
                LoreScopeId.ToString(),
                SelectedFile
            );

            if (!outcome.TryGetAsState(out bool success) || !success ) {
                Logger.Error("Failed to upload image, {@e}", outcome);
                return;
            }

            // Refresh the LoreScope model to get the updated image URL
            await OnInitializedAsync();
            SelectedFile = null;
        }
        finally {
            StateHasChanged();
        }
    }
    
    private async Task OnDeleteAsync() {
        Outcome outcome = await LoreScopeInteractiveApi.DeleteLoreScopesAsync(UserId.ToString(), LoreScopeId.ToString());
        await outcome.SwitchAsync(
            async () => {
                var toastInfo = new ToastingData("LoreScope has been deleted");

                await ToastingProvider.PublishToastAsync(toastInfo, ToastAppearance.Success);
                NavigationManager.NavigateTo("/lorescopes");
            },
            async () => {
                var toastFail = new ToastingData(
                    "Could not delete LoreScope"
                );

                await ToastingProvider.PublishToastAsync(toastFail, ToastAppearance.Error);
            },
            async error => {
                var toastFail = new ToastingData(
                    "Could not delete LoreScope",
                    Body: error
                );
                
                await ToastingProvider.PublishToastAsync(toastFail, ToastAppearance.Error);
            }
        );
    }
}