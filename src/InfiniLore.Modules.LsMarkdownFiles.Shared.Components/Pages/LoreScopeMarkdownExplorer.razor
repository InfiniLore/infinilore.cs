@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using InfiniLore.InfiniBlazor
@using InfiniLore.Modules.Core.Shared
@using InfiniLore.Modules.LsMarkdownFiles.Shared.Database
@using System.Text
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/lorescope/{LoreScopeId:guid}/markdown"
@inject IInteractiveApiLsMarkdownFiles InteractiveApi
@inject ILogger<LoreScopeMarkdownExplorer> Logger
@attribute [Authorize]
@rendermode InteractiveAuto
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniPage Title="Markdown Files"  Class="px-4 pb-4">
    <InfiniSection Location="SectionLocation.Top" Class="w-full h-49 flex flex-col gap-2">
        <InfiniHeading3 Class="flex flex-row">
            <InfiniButton
                Href="/lorescopes/"
                Variant="ButtonVariant.Transparent"
                IconName="chevron-left"/>

            LoreScope Markdown Files
        </InfiniHeading3>

        <div class="flex items-center space-x-3">
            <InfiniTextInput 
                Label="New Markdown File"
                LabelLocation="LabelLocation.OnTop"
                @bind-Value="@NewMarkdownFileName" 
                Placeholder="Enter a new markdown file name...">
                <InfiniButton IconName="check" OnClick="@CreateNewMarkdownFileAsync"
                              Disabled="@(NewMarkdownFileName.IsNullOrWhiteSpace() || !RendererInfo.IsInteractive)"/>
            </InfiniTextInput>
        </div>

    </InfiniSection>

    <InfiniSection Class="w-full grow overflow-auto">
        @if (IsLoading || !RendererInfo.IsInteractive) {
            <div class="flex flex-col h-full justify-center items-center text-(--color-base-40)">
                <LiLoaderCircle Class="animate-spin" Size="100"/>
            </div>
        }
        else {
            if (PaginatedFiles.IsEmpty) {
                <span>No files found</span>
            }
            else {
                @* Table *@
                <div class="flex flex-col overflow-auto">
                    <InfiniTable TItem="ILsMarkdownFileModel" Items="@PaginatedFiles.Items" Class="h-fit">
                        <Header>
                            <InfiniTableHeader Class="w-4/5">File Name</InfiniTableHeader>
                            <InfiniTableHeader Class="w-1/5">Actions</InfiniTableHeader>
                        </Header>
                        <Content Context="file">
                            <InfiniTableCell>@file.Name</InfiniTableCell>
                            <InfiniTableCell>
                                <div class="flex justify-center items-center gap-8">
                                    <InfiniButton
                                        Variant="ButtonVariant.Default"
                                        Href="@($"/lorescope/{LoreScopeId}/markdown/{file.Id}/editor")">
                                        Edit
                                    </InfiniButton>
                                    <InfiniButton
                                        Variant="ButtonVariant.Outline"
                                        Color="Color.Red"
                                        IconName="trash"
                                        OnClick="@(async () => await DeleteMarkdownFileAsync(file))">
                                    </InfiniButton>
                                </div>
                            </InfiniTableCell>
                        </Content>
                    </InfiniTable>
                </div>
                
                <InfiniSpacerVertical Spacing="Size.M"/>

                @* Navigation *@
                <div class="flex justify-center items-end grow">
                    <div class="flex gap-2">
                        @if (PaginatedFiles.TotalPages > 1) {
                            <InfiniButton
                                OnClick="() => NavigationButton(PaginatedFiles.CurrentPage - 1)"
                                Disabled="@(!PaginatedFiles.HasPreviousPage)">
                                Previous
                            </InfiniButton>
                        }

                        <div class="text-(--color-base-30) flex flex-col justify-center items-center">
                        <span
                            class="text-sm">Page @(PaginatedFiles.CurrentPage + 1) of @PaginatedFiles.TotalPages</span>
                            <span class="text-xs">@PaginatedFiles.TotalCount total items</span>
                        </div>

                        @if (PaginatedFiles.TotalPages > 1) {
                            <InfiniButton
                                OnClick="() => NavigationButton(PaginatedFiles.CurrentPage + 1)"
                                Disabled="@(!PaginatedFiles.HasNextPage)">
                                Next
                            </InfiniButton>
                        }
                    </div>
                </div>
            }
        }


    </InfiniSection>
</InfiniPage>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public Guid LoreScopeId { get; set; }

    private PaginatedData<ILsMarkdownFileModel> PaginatedFiles { get; set; } = PaginatedData<ILsMarkdownFileModel>.Empty;

    private string? NewMarkdownFileName { get; set; }
    private const int FilesPerPage = 64;
    private bool IsLoading { get; set; }

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        await FetchFilesAsync(0);
    }

    private async Task FetchFilesAsync(int pageNumber) {
        const int maxRetries = 3;
        const int initialDelayMs = 200;
        IsLoading = true;

        Pagination pagination;
        if (pageNumber is 0) pagination = Pagination.Default with { PageSize = FilesPerPage };
        else if (!PaginatedFiles.TryGetNextPage(FilesPerPage, out pagination)) pagination = PaginatedFiles.GetCurrentPage(FilesPerPage);

        for (int attempt = 0; attempt <= maxRetries; attempt++) {
            try {
                PaginatedOutcome<ILsMarkdownFileModel> result = await InteractiveApi.GetLsMarkdownFilesAsync(LoreScopeId.ToString(), pagination);
                if (!result.TryGetAsData(out PaginatedData<ILsMarkdownFileModel>? data)) {
                    Logger.Warning("Failed to get data on attempt {Attempt}", attempt + 1);
                    if (attempt == maxRetries) return;

                    continue;
                }

                PaginatedFiles = data;
                return;
            }
            catch (Exception ex) when (ex is HttpRequestException or TimeoutException or TaskCanceledException) {
                if (attempt == maxRetries) throw;

                double delayMs = initialDelayMs * Math.Pow(2, attempt);
                Logger.Warning(ex, "Failed to fetch files (attempt {Attempt}/{MaxRetries}). Retrying in {Delay}ms",
                    attempt + 1, maxRetries, delayMs);

                await Task.Delay(TimeSpan.FromMilliseconds(delayMs));
            }
            finally {
                IsLoading = false;
            }
        }
    }

    private async Task DeleteMarkdownFileAsync(ILsMarkdownFileModel file) {
        await InteractiveApi.DeleteLsMarkdownFileAsync(file.OwnerId.ToString(), file.Id.ToString());
        await FetchFilesAsync(0);
        StateHasChanged();
    }

    private async Task CreateNewMarkdownFileAsync() {
        if (NewMarkdownFileName.IsNullOrEmpty()) return;

        byte[] textBytes = Encoding.UTF8.GetBytes($"# File: {NewMarkdownFileName}");
        using var stream = new MemoryStream(textBytes);

        string? fileName = NewMarkdownFileName.EndsWith(".md")
            ? NewMarkdownFileName
            : $"{NewMarkdownFileName}.md";

        await InteractiveApi.UpsertLsMarkdownFileAsync(
            LoreScopeId.ToString(),
            fileName,
            stream
        );

        await FetchFilesAsync(0);
        StateHasChanged();
    }

    private async Task NavigationButton(int page) {
        await FetchFilesAsync(page);
        StateHasChanged();
    }
}