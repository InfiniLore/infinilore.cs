@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using InfiniLore.Lucide
@using Microsoft.Extensions.Hosting

@namespace InfiniLore.Core.Layouts
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@rendermode InfiniRenderModeProvider.InfiniRenderMode
@inherits InfiniNavBarBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniNavBar Location="NavBarLocation.Left" Size="Size" Class="@Class" @bind-NavBarCollapsed="CollapsedState">
    <div class="flex flex-row justify-between sticky top-0 z-10 overload-bg-infini-nav-top border-b-1 border-infini-nav-border">
        <InfiniNavLink
            Href="/"
            Text="InfiniLore"
            Class="@ConcatClasses(HiddenIf(CollapsedState), "font-bold")"
            HiddenOnCollapsed
        />

        <InfiniNavCollapseButton @bind-State="CollapsedState" Class="h-10"/>
    </div>
    
    @if (IsDevelopment)
    {
        <InfiniSpacerVertical/>
        <InfiniNavLink
            Href="/swagger"
            Text="API Docs"
            Icon="@LucideNames.ChevronsLeftRightEllipsis"
            OpenInNewTab
        />
    }
</InfiniNavBar>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public bool CollapsedState { get; set; }

    [Inject] private IHostEnvironment Environment { get; set; } = null!;

    private bool IsDevelopment => Environment?.IsDevelopment() ?? false;
}