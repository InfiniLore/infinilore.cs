@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@using InfiniLore.InfiniBlazor
@using InfiniLore.InfiniBlazor.Debugger
@using InfiniLore.InfiniBlazor.Theming
@using InfiniLore.Modules.Core.Shared
@using InfiniLore.Modules.Core.Shared.Database
@using System.Security.Claims
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@rendermode InteractiveAuto
@inject IJwtTokenManager JsTokenProvider
@inject IThemeSelector ThemeSelector
@inject IInteractiveApiUsers UserInteractiveApi
@inject IVisualDebuggerProvider DebuggerProvider
@inject NavigationManager NavigationManager
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html *@
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniSideNav @bind-MenuCollapsed="@MenuCollapsed" Size="SideNavSize.Large">
    <Header>
        <a href="/"
           class="@(!MenuCollapsed ? "text-1xl font-bold text-(--color-base-00) hover:text-(--color-accent) no-underline" : "hidden")">
            InfiniLore
        </a>
    </Header>

    <Body>
    <InfiniSideNavLink Href="/about">
        <Icon>
            <LiEqualApproximately/>
        </Icon>
        <Text>About</Text>
    </InfiniSideNavLink>

    <AuthorizeView>
        <NotAuthorized></NotAuthorized>
        <Authorized>
            <InfiniSideNavLink Href="/api-test">
                <Icon>
                    <LiPlus/>
                </Icon>
                <Text>Api Test</Text>
            </InfiniSideNavLink>

            <InfiniSideNavLink Href="/lorescopes">
                <Icon>
                    <LiSignature/>
                </Icon>
                <Text>LoreScopes</Text>
            </InfiniSideNavLink>

            <InfiniSideNavLink Href="/claims-viewer">
                <Icon>
                    <LiView/>
                </Icon>
                <Text>Claims viewer</Text>
            </InfiniSideNavLink>
        </Authorized>
    </AuthorizeView>
    
    <InfiniSpacer/>

    <InfiniSideNavLink Href="/swagger" OpenInNewTab>
        <Icon>
            <LiBraces/>
        </Icon>
        <Text>Swagger</Text>
    </InfiniSideNavLink>
    
    <InfiniSideNavToggleButton
        Value="@DebuggerProvider.IsEnabled()"
        ValueChanged="@DebuggerProvider.ToggleStateAsync"
        OnIcon="@(MenuCollapsed ? "bug" : null)"
        OffIcon="@(MenuCollapsed ? "bug" : null)"
        Color="Color.Red">
        <Icon><LiBug/></Icon>
        <Text>Toggle Debug</Text>
    </InfiniSideNavToggleButton>

    <InfiniSideNavToggleButton
        Value="@(ThemeSelector.CurrentThemeMode.Name != ThemeMode.DarkMode.Name)"
        ValueChanged="@OnThemeSwitchAsync"
        OnIcon="sun"
        OffIcon="moon">
        <Icon><LiSun/></Icon>
        <Text>Toggle Mode</Text>
    </InfiniSideNavToggleButton>
    </Body>

    <Footer>
        <AuthorizeView>
            <NotAuthorized>
                <InfiniSideNavLink Href="account/login?redirectUri=/">
                    <Icon>
                        <LiKeyRound
                            class="@($"transition-all duration-300 {(MenuCollapsed ? "opacity-100" : "opacity-0")}")"/>
                    </Icon>
                    <Text>Login</Text>
                </InfiniSideNavLink>
                <InfiniSideNavLink Href="account/login?redirectUri=/">
                    <Icon>
                        <LiSignpost
                            class="@($"transition-all duration-300 {(MenuCollapsed ? "opacity-100" : "opacity-0")}")"/>
                    </Icon>
                    <Text>SignUp</Text>
                </InfiniSideNavLink>
            </NotAuthorized>

            <Authorized>
                <!-- Profile Icon -->
                <InfiniSideNavUser
                    HrefUserProfile="/account/profile"
                    UserName="@UserModel.Username">
                    <Icon>
                        <InfiniUserIcon
                            HrefUserProfile="/account/profile"
                            ImageUrl="@UserModel.ProfileImageUrl"/>
                    </Icon>
                    <AdditionalLinks>
                        <NavLink @onclick="LogoutCallbackAsync"
                                 href="/account/logout"
                                 class="text-sm text-(--color-red) whitespace-nowrap hover:text-(--color-accent)">
                            logout
                        </NavLink>
                    </AdditionalLinks>
                </InfiniSideNavUser>
            </Authorized>
        </AuthorizeView>
    </Footer>
</InfiniSideNav>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code *@
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    // Cascading authentication state
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // State for user details
    private bool MenuCollapsed { get; set; }// Tracks whether the menu is collapsed
    private IInfiniLoreUserModel UserModel { get; set; } = new DefaultInfiniLoreUserModel();
    
    private bool _isFirstRender = true;
    private string? _userIdToLogout;

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        if (AuthenticationStateTask is null) return;

        AuthenticationState authState = await AuthenticationStateTask;
        ClaimsPrincipal user = authState.User;

        if (user.Identity is { IsAuthenticated: true }) {
            string? userId = user.FindFirst(InfiniLoreClaimsStoreConstants.UserId)?.Value;
            if (userId is null) {
                _userIdToLogout = userId;// Set flag instead of calling JS
                return;
            }

            Outcome<IInfiniLoreUserModel> outcome = await UserInteractiveApi.GetUserAsync(userId);
            if (!outcome.TryGetAsData(out IInfiniLoreUserModel? userModel)) {
                _userIdToLogout = userId;// Set flag instead of calling JS
                return;
            }

            UserModel = userModel;
        }

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;

        _isFirstRender = false; 
        if (_userIdToLogout == null) return;

        await JsTokenProvider.RemoveTokenAsync();
        NavigationManager.NavigateTo("/account/logout");
    }

    private async Task LogoutCallbackAsync() {
        if (_isFirstRender) return;

        await JsTokenProvider.RemoveTokenAsync();
    }

    private async Task OnThemeSwitchAsync() {
        if (_isFirstRender) return;

        await ThemeSelector.TrySelectNextThemeModeAsync();
    }
}
