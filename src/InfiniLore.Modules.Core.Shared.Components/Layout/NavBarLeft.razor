@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@using InfiniLore.Modules.Core.Shared
@using InfiniLore.Modules.Core.Shared.Database

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@rendermode InteractiveAuto
@inject IJwtTokenManager JsTokenProvider
@inject IThemeStateProvider ThemeStateProvider
@inject IInteractiveApiUsers UserInteractiveApi
@inject IVisualDebuggerProvider DebuggerProvider
@inject IUserStateContainer UserStateContainer
@inherits InfiniNavBarBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html *@
@* ------------------------------------------------------------------------------------------------------------------ *@
<InfiniNavBar @bind-NavBarCollapsed="CollapsedState" Size="Size.M" Location="NavBarLocation.Left">
    <div class="flex flex-row justify-between">
        <InfiniNavLink
            Href="/"
            Text="InfiniBlazor"
            Class="@ConcatClasses(HiddenIf(CollapsedState), "font-bold")"
            HiddenOnCollapsed
        />

        <InfiniNavCollapseButton @bind-State="CollapsedState" Class="h-10"/>
    </div>
    
    <InfiniNavBreak/>

    <InfiniNavLink
        Href="/about"
        Icon="@LucideNames.EqualApproximately"
        Text="About"/>


    <AuthorizeView>
        <NotAuthorized></NotAuthorized>
        <Authorized>
            <InfiniNavLink Href="/api-test" Icon="@LucideNames.Plus" Text="ApiTest"/>
            <InfiniNavLink Href="/lorescopes" Icon="@LucideNames.Signature" Text="LoreScopes"/>

            @if (DebuggerProvider.IsEnabled()) {
                <InfiniNavLink Href="/claims-viewer"
                               Class="[&_svg]:text-(--color-red-light) [&_svg]:group-hover:text-(--sidebar-nav-text-hover) [&_span]:text-(--color-red-light)"
                               Icon="@LucideNames.View"
                               Text="Claims viewer"/>
            }
        </Authorized>
    </AuthorizeView>

    <InfiniSpacer/>

    <InfiniNavLink Href="/swagger" OpenInNewTab Icon="@LucideNames.Braces" Text="Swagger"/>

    <InfiniNavToggleButton
        Value="@DebuggerProvider.IsEnabled()"
        ValueChanged="@DebuggerProvider.ToggleStateAsync"
        OnIcon="@LucideNames.Bug"
        OffIcon="@LucideNames.Bug"
        Color="Color.Red"
        Icon="@LucideNames.Bug"
        Text="Toggle Debug"/>

    @if (ThemeStateProvider.GetState().IsBinaryCollection) {
        <InfiniNavToggleButton
            Value="@(ToggleState)"
            ValueChanged="@OnThemeModeChanged"
            OnIcon="sun"
            OffIcon="moon"
            Icon="@LucideNames.Sun"
            Text="Toggle Mode"/>
    }
    else {
        <InfiniNavButton OnClick="@OnThemeModeChanged" Icon="@LucideNames.Sun" Text="Toggle Mode"/>
    }

    <AuthorizeView>
        <Authorizing>
        </Authorizing>
        <NotAuthorized>
            <div class="transition-opacity duration-150">

                <InfiniNavLink
                    Href="account/login?redirectUri=/"
                    Icon="@LucideNames.KeyRound" 
                    Class="@ConcatClasses("[&_svg]:transition-all [&_svg]:duration-150", CollapsedState ? "opacity-100" : "opacity-0")"
                    Text="Login"/>
                <InfiniNavLink 
                    Href="account/login?redirectUri=/"
                    Icon="@LucideNames.Signpost" 
                    Class="@ConcatClasses("[&_svg]:transition-all [&_svg]:duration-150", CollapsedState ? "opacity-100" : "opacity-0")"
                    Text="Sign up"/>
            </div>
        </NotAuthorized>

        <Authorized>
            <div class="transition-opacity duration-150 opacity-100">
                @if (UserModel is not null) {
                    <!-- Profile Icon -->
                    <InfiniNavUser
                        HrefUserProfile="/account/profile"
                        UserName="@UserModel.Username">
                        <UserIcon>
                            <InfiniUserIcon
                                HrefUserProfile="/account/profile"
                                ImageUrl="@UserModel.ProfileImageUrl"/>
                        </UserIcon>
                        <AdditionalLinks>
                            <NavLink @onclick="LogoutCallbackAsync"
                                     href="/account/logout"
                                     class="text-sm text-(--color-red) whitespace-nowrap hover:text-(--color-accent)">
                                logout
                            </NavLink>
                        </AdditionalLinks>
                    </InfiniNavUser>
                }
                else {
                    <InfiniNavUser
                        HrefUserProfile="/account/profile"
                        UserName="@("\u00A0")">
                        <UserIcon>
                            <div class="w-8 h-8 flex justify-center items-center">
                                <LiLoaderCircle class="text-(--color-base-30) animate-spin"/>
                            </div>
                        </UserIcon>
                        <AdditionalLinks>
                            <NavLink @onclick="LogoutCallbackAsync"
                                     href="/account/logout"
                                     class="text-sm text-(--color-red) whitespace-nowrap hover:text-(--color-accent)">
                                logout
                            </NavLink>
                        </AdditionalLinks>
                    </InfiniNavUser>
                }
            </div>
        </Authorized>
    </AuthorizeView>
</InfiniNavBar>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code *@
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    // Cascading authentication state
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // State for user details
    private bool CollapsedState { get; set; }// Tracks whether the menu is collapsed
    private IInfiniLoreUserModel? UserModel { get; set; }

    private bool _isFirstRender = true;
    private bool ToggleState { get; set; }


    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override void OnInitialized() {
        UserStateContainer.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            _isFirstRender = false;
            await InitializeUserModelAsync();
            StateHasChanged();
        }
    }

    private async Task InitializeUserModelAsync() {
        try {
            // Try state container first
            if (await UserStateContainer.GetIsAuthenticatedAsync()) {
                UserModel = await UserStateContainer.GetUserAsync();
                return;
            }

            // Fall back to auth state
            if (AuthenticationStateTask == null) return;

            AuthenticationState authState = await AuthenticationStateTask;
            if (authState.User.Identity?.IsAuthenticated != true) return;

            string? userId = authState.User.FindFirst(InfiniLoreClaimsStoreConstants.UserId)?.Value;
            if (userId == null) return;

            Outcome<IInfiniLoreUserModel> outcome = await UserInteractiveApi.GetUserAsync(userId);
            if (!outcome.TryGetAsData(out IInfiniLoreUserModel? userModel)) return;

            UserModel = userModel;
            await UserStateContainer.SetUserAsync(userModel);
            await UserStateContainer.SetIsAuthenticatedAsync(true);
        }
        catch {
            // ignored
        }
    }

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender) _isFirstRender = false;
    }

    private async Task LogoutCallbackAsync() {
        if (_isFirstRender) return;

        await UserStateContainer.SetIsAuthenticatedAsync(false);
        await UserStateContainer.RemoveUserAsync();
        await JsTokenProvider.RemoveTokenAsync();
    }

    private async Task OnThemeModeChanged() {
        await ThemeStateProvider.TrySelectNextModeAsync();

        IThemeState state = ThemeStateProvider.GetState();
        ToggleState = state.ModeName != state.FirstModeInCollectionName;

        StateHasChanged();
    }

    public void Dispose() {
        UserStateContainer.OnChange -= StateHasChanged;
    }
}
