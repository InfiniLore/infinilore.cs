<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>InfiniLore.Server</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AterraEngine.Unions"/>
        <PackageReference Include="AterraEngine.Unions.Generators">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="CodeOfChaos.Extensions" />
        <PackageReference Include="CodeOfChaos.Extensions.DependencyInjection" />
        <PackageReference Include="CodeOfChaos.Extensions.MicrosoftLogging" />
        <PackageReference Include="CodeOfChaos.Types.UnitOfWork.Contracts"/>
        <PackageReference Include="InfiniLore.Credentials.Auth0.Contracts" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\InfiniLore.Shared.Contracts\InfiniLore.Shared.Contracts.csproj" />
    </ItemGroup>

</Project>
