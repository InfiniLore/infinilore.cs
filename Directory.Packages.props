    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="InfiniLore.InfiniBlazor" Version="0.1.0-preview.120" />
    <PackageVersion Include="InfiniLore.InfiniFrame" Version="0.1.0-preview.25" />
