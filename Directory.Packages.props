    <PackageVersion Include="CodeOfChaos.Extensions.EntityFrameworkCore" Version="0.87.2" />
    <PackageVersion Include="CodeOfChaos.Extensions.MicrosoftLogging" Version="0.87.2" />
    <PackageVersion Include="CodeOfChaos.Extensions.Serilog" Version="0.87.2" />
    <PackageVersion Include="CodeOfChaos.Testing.TUnit" Version="0.17.0" />
    <PackageVersion Include="CodeOfChaos.Unions" Version="6.5.0" />
    <PackageVersion Include="CodeOfChaos.Unions.Generators" Version="6.4.0" />
    <PackageVersion Include="FastEndpoints" Version="8.0.1" />
