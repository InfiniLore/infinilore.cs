    <PackageVersion Include="CodeOfChaos.CliArgsParser.Generators" Version="5.1.3" />
    <PackageVersion Include="CodeOfChaos.Extensions.DependencyInjection" Version="0.86.0" />
    <PackageVersion Include="CodeOfChaos.Extensions.DependencyInjection.Generators" Version="0.86.0" />
    <PackageVersion Include="CodeOfChaos.Extensions.EntityFrameworkCore" Version="0.86.0" />
    <PackageVersion Include="CodeOfChaos.Extensions.MicrosoftLogging" Version="0.86.0" />
    <PackageVersion Include="CodeOfChaos.Extensions.Serilog" Version="0.86.0" />
    <PackageVersion Include="CodeOfChaos.Testing.TUnit" Version="0.16.2" />
    <PackageVersion Include="FastEndpoints" Version="7.1.1" />
    <PackageVersion Include="FastEndpoints.Messaging.Core" Version="7.1.1" />
    <PackageVersion Include="FluentValidation" Version="12.1.0" />
    <PackageVersion Include="InfiniLore.InfiniBlazor" Version="0.1.0-preview.111" />
    <PackageVersion Include="InfiniLore.InfiniFrame" Version="0.1.0-preview.8" />
    <PackageVersion Include="InfiniLore.InfiniFrame.Blazor" Version="0.1.0-preview.8" />
    <PackageVersion Include="InfiniLore.InfiniFrame.Server" Version="0.1.0-preview.8" />
    <PackageVersion Include="Microsoft.CodeAnalysis" Version="5.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
